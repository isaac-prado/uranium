+                # If we see a dot, continue to next part
+                if self._current == ".":
+                    self.inc()  # consume the dot
+                else:
+                    break
+            
+            # Combine all parts into one dotted key
+            dotted_key_str = ".".join(parts)
+            from .items import DottedKey
+            key = DottedKey(dotted_key_str, sep="")
+        else:
+            # Not a dotted key, use the first key we parsed
