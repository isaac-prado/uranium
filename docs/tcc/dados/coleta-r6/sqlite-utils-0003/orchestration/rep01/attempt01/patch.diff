+def chunks(sequence: Sequence[T], size: int) -> Iterator[Sequence[T]]:
+    """Yield successive chunks of a sequence in smaller sequences of max `size`."""
+    # Convert to list if it's not already indexable
+    if not hasattr(sequence, '__getitem__'):
+        sequence = list(sequence)
+    
+    # Now we can safely calculate length and iterate
+    seq_len = len(sequence)
+    batch_count = (seq_len + size - 1) // size  # Ceiling division
+    for i in range(batch_count):
+        yield sequence[i * size : min((i + 1) * size, seq_len)]
+
