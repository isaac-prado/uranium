+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names (potentially with duplicates), return a new
+    list where the duplicates have been given unique names by appending a
+    suffix '_N' starting from 2. The first occurrence remains unchanged.
+    
+    The renaming ensures the new name does not conflict with any existing key
+    in the original list.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+    
+    # Count occurrences of each key
+    counts: Dict[str, int] = {}
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+    
+    # If no duplicates, return original list
+    if all(count == 1 for count in counts.values()):
+        return keys[:]
+    
+    # Set of all original keys to avoid conflicts
+    original_keys = set(keys)
+    result: List[str] = []
+    seen_counts: Dict[str, int] = {}
+    
+    for key in keys:
+        if counts[key] == 1:
+            # No duplicates for this key, keep as is
+            result.append(key)
+            seen_counts[key] = seen_counts.get(key, 0) + 1
+        else:
+            # There are duplicates, need to rename
+            seen_count = seen_counts.get(key, 0)
+            if seen_count == 0:
+                # First occurrence, keep original name
+                result.append(key)
+            else:
+                # Subsequent occurrence, generate a new unique name
+                counter = seen_count + 1
+                new_key = f"{key}_{counter}"
+                # Ensure new_key doesn't conflict with any original key
+                while new_key in original_keys:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result.append(new_key)
+            seen_counts[key] = seen_count + 1
+            
+    return result
+
