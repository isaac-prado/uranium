+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Renames duplicate keys by appending a suffix '_N' where N is the occurrence count,
+    ensuring uniqueness. The first occurrence remains unchanged.
+    
+    Examples:
+        [] -> []
+        ['id', 'name'] -> ['id', 'name']
+        ['id', 'id'] -> ['id', 'id_2']
+        ['id', 'id', 'id'] -> ['id', 'id_2', 'id_3']
+        ['id', 'id', 'id_2'] -> ['id', 'id_3', 'id_2']
+        ['id_2', 'id', 'id'] -> ['id_2', 'id', 'id_3']
+        ['id', 'id', 'id_2', 'id_2'] -> ['id', 'id_3', 'id_2', 'id_2_2']
+    """
+    if not keys:
+        return []
+        
+    # Count occurrences of each key
+    counts: Dict[str, int] = {}
+    # Track the order and original keys
+    result: List[str] = []
+    seen_counts: Dict[str, int] = {}
+    
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+        
+    for key in keys:
+        if counts[key] == 1:
+            # Unique key, no change needed
+            result.append(key)
         else:
-            yield key, value
+            # Duplicate key, need to rename
+            seen_counts[key] = seen_counts.get(key, 0) + 1
+            if seen_counts[key] == 1:
+                # First occurrence stays as is
+                result.append(key)
+            else:
+                # Subsequent occurrences get renamed
+                new_key = f"{key}_{seen_counts[key]}"
+                # Handle potential conflicts (e.g., if 'id_2' already exists)
+                counter = seen_counts[key]
+                while new_key in counts or new_key in result:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result.append(new_key)
+                
+    return result
 
 
