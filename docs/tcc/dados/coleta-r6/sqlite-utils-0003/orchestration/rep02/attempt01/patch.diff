+def resolve_extras(
+    record: Dict[str, Any],
+    *,
+    columns: Optional[Dict[str, str]] = None,
+    defaults: Optional[Dict[str, Any]] = None,
+    extras_key: Optional[str] = None,
+) -> Dict[str, Any]:
+    """Resolve extra keys in a record according to provided strategies."""
+    if not extras_key and not columns and not defaults:
+        return record
+
+    resolved = {}
+    used_keys = set()
+
+    # Apply columns mapping
+    if columns:
+        for key, mapped_key in columns.items():
+            if key in record:
+                resolved[mapped_key] = record[key]
+                used_keys.add(key)
+
+    # Apply defaults
+    if defaults:
+        for key, default_value in defaults.items():
+            if key not in record:
+                resolved[key] = default_value
+
+    # Handle extras
+    extras = {k: v for k, v in record.items() if k not in used_keys}
+    if extras_key and extras:
+        resolved[extras_key] = extras
+    elif extras:
+        resolved.update(extras)
+
+    return resolved
