@@ -3103,10 +3103,38 @@ class Table(Queryable):
         if "rowid" not in new_cols:
             new_cols.insert(0, "rowid")
             old_cols.insert(0, "rowid")
+        
+        # Apply NULLIF(column, '') for TEXT to numeric conversions
+        old_cols_processed = []
