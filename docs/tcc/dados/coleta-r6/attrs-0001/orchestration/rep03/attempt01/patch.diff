     return rv if tuple_factory is list else tuple_factory(rv)
 
 
+def _is_generic_alias(obj):
+    """Check if an object is a GenericAlias."""
+    # Check for _GenericAlias first, as it's used in older versions and sometimes in newer ones
+    typing_module = sys.modules.get('typing')
+    if typing_module:
+        generic_alias_type = getattr(typing_module, '_GenericAlias', None)
+        if generic_alias_type:
+            if isinstance(obj, generic_alias_type):
+                return True
+    
+    if sys.version_info >= (3, 9):
+        if isinstance(obj, types.GenericAlias):
+            return True
+            
+    return False
+
