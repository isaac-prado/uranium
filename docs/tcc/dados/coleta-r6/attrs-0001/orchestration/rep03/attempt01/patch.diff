@@ -296,6 +315,10 @@ def has(cls):
 
     :rtype: bool
     """
+    # Handle generic aliases by extracting the origin class
+    if _is_generic_alias(cls):
+        cls = cls.__origin__
+        
     return getattr(cls, "__attrs_attrs__", None) is not None
 
 
