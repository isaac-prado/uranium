+            # For dotted keys, we need to create the nested structure
+            names = tuple(iter(key))
+            first_name = names[0]
+            first_name._dotted = True
+            
+            # Check if the first part already exists
+            if first_name in self:
+                # If it exists and is not a table, we have a conflict
+                existing = self[first_name]
+                if not isinstance(existing, Table):
+                    raise KeyAlreadyPresent(first_name)
+                # If it's a table, we'll add to it
+                table = existing
+            else:
+                # Create a super table for the first part
