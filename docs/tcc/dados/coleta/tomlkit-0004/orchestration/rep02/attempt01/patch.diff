+def _escaped_char(src, pos):
+    """Process escaped characters in strings"""
+    c = src[pos + 1]
+    if c in "'\"\\bnfrt":
+        return {"b": "\b", "n": "\n", "f": "\f", "r": "\r", "t": "\t"}.get(c, c), pos + 2
+    elif c == "u":
+        # Unicode de 4 dígitos
+        if pos + 5 >= len(src):
+            raise ValueError("Invalid unicode escape sequence")
+        code = src[pos + 2:pos + 6]
+        try:
+            char = chr(int(code, 16))
+            return char, pos + 6
+        except ValueError:
+            raise ValueError(f"Invalid unicode escape sequence: \\u{code}")
+    elif c == "U":
+        # Unicode de 8 dígitos
+        if pos + 9 >= len(src):
+            raise ValueError("Invalid unicode escape sequence")
+        code = src[pos + 2:pos + 10]
+        try:
+            char = chr(int(code, 16))
+            return char, pos + 10
+        except ValueError:
+            raise ValueError(f"Invalid unicode escape sequence: \\U{code}")
+    elif c in "\n\r":
+        # Quebra de linha escapada - continuar na próxima linha
+        return "", pos + 2
+    else:
+        # Caractere qualquer escapado
+        return c, pos + 2
+
+
+def _escaped(src, pos):
+    """Handle escaped characters in strings"""
+    try:
+        return _escaped_char(src, pos)
+    except (ValueError, IndexError):
+        # If we can't process the escape, treat it literally
+        return src[pos + 1], pos + 2
+
