+    def _is_dotted_key(self, key):  # type: (Key) -> bool
+        """
+        Check if a key is a dotted key.
+        A dotted key has multiple parts separated by dots.
+        Quoted keys like "with.dot" are NOT dotted keys.
+        Keys like site."google.com" ARE dotted keys.
+        """
+        # If the entire key is quoted, it's not a dotted key
+        key_str = key.key
+        if ((key_str.startswith('"') and key_str.endswith('"')) or 
+            (key_str.startswith("'") and key_str.endswith("'"))):
+            return False
+            
+        # Check if it contains unquoted dots (dots not inside quotes)
+        in_quotes = False
+        quote_char = None
+        for i, char in enumerate(key_str):
+            if not in_quotes and char in "\"'":
+                in_quotes = True
+                quote_char = char
+            elif in_quotes and char == quote_char:
+                in_quotes = False
+                quote_char = None
+            elif not in_quotes and char == '.':
+                # Found unquoted dot, this is a dotted key
+                return True
+                
+        return False
+
+    def _handle_dotted_key(self, body, key, value):  # type: (Container, Key, Item) -> None
+        """
+        Handle dotted keys by creating nested structure.
+        Properly handles quoted parts in dotted keys.
+        """
+        from .container import Container
+        from .items import Table, Trivia
+        
+        # Parse the dotted key properly, respecting quoted parts
+        parts = self._split_dotted_key(key.key)
+        current = body
+        for i, part in enumerate(parts[:-1]):
+            # Check if part already exists as a table
+            if part not in current:
+                # Create new table for this part
+                new_table = Table(
+                    Container(),
+                    Trivia(indent="", comment_ws="", comment="", trail=""),
+                    False,
+                    is_super_table=True,
+                )
+                current.append(part, new_table)
+                current = new_table
+            else:
+                # Use existing table
+                existing = current[part]
+                from .items import InlineTable
+                if not isinstance(existing, (Table, InlineTable)):
+                    raise KeyError("Key {} conflicts with existing value".format(key.key))
+                current = existing
+        
+        # Set the final value
+        current.append(parts[-1], value)
+    
+    def _split_dotted_key(self, key_str):  # type: (str) -> list
+        """
+        Split a dotted key into its parts, respecting quoted sections.
+        """
+        parts = []
+        current_part = ""
+        in_quotes = False
+        quote_char = None
+        i = 0
+        
+        while i < len(key_str):
+            char = key_str[i]
+            
+            if not in_quotes and char in "\"'":
+                in_quotes = True
+                quote_char = char
+                current_part += char
+            elif in_quotes and char == quote_char:
+                in_quotes = False
+                quote_char = None
+                current_part += char
+            elif not in_quotes and char == '.':
+                # End of current part
+                if current_part:
+                    parts.append(current_part)
+                    current_part = ""
+            else:
+                current_part += char
+                
+            i += 1
+            
+        # Add the last part
+        if current_part:
+            parts.append(current_part)
+            
+        return parts
+
