+                            new_table = Table(Container(), Trivia(indent="", comment_ws="", comment="", trail="\n"), False)
+                            current_container.append(part_key, new_table)
+                            current_container = new_table.value
+                    
+                    else:
+                        # Add the final value to the deepest table
+                        final_key = Key(parts[-1])
+                        current_container.append(final_key, value)
