-                body.append(key, value)
+                # Handle dotted keys specially
+                if hasattr(key, '_is_dotted') and key._is_dotted:
+                    # Create nested structure for dotted key
+                    parts = key._dotted_parts
+                    current_container = body
+                    
+                    from .container import Container
+                    
+                    # Navigate/create intermediate tables
+                    for i, part in enumerate(parts[:-1]):  # All parts except the last
