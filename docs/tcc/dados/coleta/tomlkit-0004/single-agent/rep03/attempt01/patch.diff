+                                # This is the container inside a Table, use it directly
+                                current_container = existing
+                            elif isinstance(existing, Table):
+                                current_container = existing.value
+                            else:
+                                # If it's not a table/container, we have a conflict
+                                # This matches TOML spec behavior - stop here and add to current level
