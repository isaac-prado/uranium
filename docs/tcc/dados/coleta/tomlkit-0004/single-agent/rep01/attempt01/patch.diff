+    def _handle_dotted_key(self, container, key, value):  # type: (Container, Key, Item) -> None
+        """
+        Handle dotted keys by creating nested table structures.
+        """
+        from .items import Table
+        from .container import Container as ItemsContainer
+        from .items import Trivia
+        
+        # Split the dotted key into parts
+        parts = list(self._split_table_name(key.key))
+        
+        # Navigate/create nested structure
+        current_container = container
+        for i, part in enumerate(parts[:-1]):  # All parts except the last one
+            if part.key not in current_container:
+                # Create new table for this part
+                trivia = Trivia(trail="")
+                new_table = Table(ItemsContainer(), trivia, False, is_super_table=True)
+                current_container.append(part, new_table)
+                current_container = new_table
+            else:
+                # Get existing table by looking through the body directly
+                existing_item = None
+                container_to_search = current_container
+                # If this is a Table, we need to look in its value (which is a Container)
+                if hasattr(container_to_search, 'value') and hasattr(container_to_search.value, 'body'):
+                    container_to_search = container_to_search.value
+                
+                for k, v in container_to_search.body:
+                    if k is not None and k.key == part.key:
+                        existing_item = v
+                        break
+                
+                if existing_item is not None and isinstance(existing_item, Table):
+                    current_container = existing_item
+                else:
+                    # This shouldn't happen in valid TOML, but let's handle it gracefully
+                    current_container = container
+                    break
+        
+        # Add the final value to the deepest table
+        final_part = parts[-1]
+        current_container.append(final_part, value)
+
