diff --git a/tomlkit/parser.py b/tomlkit/parser.py
index 59045a2..40b6053 100644
--- a/tomlkit/parser.py
+++ b/tomlkit/parser.py
@@ -402,6 +402,34 @@ class Parser:
         Parses a Key at the current position;
         WS before the key must be exhausted first at the callsite.
         """
+        # Check if this might be a dotted key by looking ahead for dots
+        saved_idx = self._save_idx()
+        
+        # Look ahead to see if there's a dot that's not inside quotes
+        in_quote = None
+        pos = 0
+        while True:
+            if self._idx + pos >= len(self._src):
+                break
+            c = self._src[self._idx + pos]
+            
+            if c in "\"'" and (pos == 0 or self._src[self._idx + pos - 1] != "\\"):
+                if in_quote is None:
+                    in_quote = c
+                elif in_quote == c:
+                    in_quote = None
+            elif c == "." and in_quote is None:
+                # Found a dot outside of quotes - this is a dotted key
+                self._restore_idx(*saved_idx)
+                return self._parse_dotted_key()
+            elif c in " \t=" or TOMLChar(c).is_nl():
+                # Reached end of key
+                break
+            
+            pos += 1
+        
+        self._restore_idx(*saved_idx)
+        
         if self._current in "\"'":
             return self._parse_quoted_key()
         else:
@@ -1030,3 +1058,40 @@ class Parser:
         self._marker = marker
 
         return value, extracted
+
+    def _parse_dotted_key(self):  # type: () -> Key
+        """
+        Parses a dotted key into its components.
+        This method returns a special Key object that represents a dotted key path.
+        """
+        start_idx = self._idx
+        self.mark()
+        
+        # Parse the full dotted key string
+        in_quote = None
+        while not self.end():
+            c = self._current
+            
+            # Handle quotes
+            if c in "\"'" and (self._idx == start_idx or self._src[self._idx - 1] != "\\"):
+                if in_quote is None:
+                    in_quote = c
+                elif in_quote == c:
+                    in_quote = None
+            
+            # Stop at separator
+            if c == "=" and in_quote is None:
+                break
+                
+            # Stop at end of line or whitespace if not in quotes
+            if (c.is_ws() or c == "#") and in_quote is None:
+                break
+                
+            self.inc()
+        
+        full_key = self.extract().strip()
+        print(f"DEBUG: Parsed dotted key: {repr(full_key)}")  # DEBUG
+        
+        # Create a special key to represent the dotted key path
+        # The actual nesting will be handled during assignment
+        return Key(full_key, sep="")
