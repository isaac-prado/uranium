@@ -550,6 +550,26 @@ class Item:
         raise TypeError(f"{type(self).__name__} does not support item deletion")
 
 
+class ScalarItem(Item):
+    """
+    A scalar item that does not support item access.
+    """
+    
+    def __init__(self, trivia=None):
+        super().__init__(trivia or Trivia())
+        
+    # Remover completamente o método __getitem__ para evitar 
+    # que o objeto seja reconhecido como sequência
+    def __getitem__(self, key):
+        raise AttributeError(f"'{type(self).__name__}' object has no attribute '__getitem__'")
+        
+    # Usar property para ocultar completamente o método
+    def _get_getitem(self):
+        raise AttributeError(f"'{type(self).__name__}' object has no attribute '__getitem__'")
+        
+    __getitem__ = property(_get_getitem)  # type: ignore[assignment]
+
+
