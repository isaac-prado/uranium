diff --git a/src/attr/_funcs.py b/src/attr/_funcs.py
index 518be16e..2e57419d 100644
--- a/src/attr/_funcs.py
+++ b/src/attr/_funcs.py
@@ -296,7 +296,19 @@ def has(cls):
 
     :rtype: bool
     """
-    return getattr(cls, "__attrs_attrs__", None) is not None
+    # Handle generic specializations (e.g., MyClass[str])
+    attrs = getattr(cls, "__attrs_attrs__", None)
+    if attrs is not None:
+        return True
+    
+    # Check if this is a specialized generic class
+    if hasattr(cls, '__origin__'):
+        # This is a specialized generic, check the origin class
+        origin_cls = cls.__origin__
+        attrs = getattr(origin_cls, "__attrs_attrs__", None)
+        return attrs is not None
+        
+    return False
 
 
