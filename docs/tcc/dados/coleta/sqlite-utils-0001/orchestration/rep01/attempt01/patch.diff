+                ON 
+                    fk."table" = ?
+                WHERE 
+                    m.type = 'table'
+            """
+            cursor = self.db.execute(query, (self.name,))
+            for referencing_table, on_delete in cursor.fetchall():
+                if on_delete in destructive_actions:
+                    referencing_tables_with_actions.append((referencing_table, on_delete))
+            
+            if referencing_tables_with_actions:
+                table_list_str = ", ".join(
+                    [f"'{table}' (ON DELETE {action})" for table, action in referencing_tables_with_actions]
+                )
+                raise TransactionError(
+                    f"Cannot perform schema transformation on table '{self.name}' while a transaction is open, "
+                    f"because it is referenced by tables with destructive ON DELETE clauses: {table_list_str}. "
+                    f"This is to prevent silent data loss due to SQLite's limitation where PRAGMA foreign_keys has no effect during transactions."
+                )
