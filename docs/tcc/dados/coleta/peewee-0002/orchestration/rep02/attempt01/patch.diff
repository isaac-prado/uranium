+             scale, default) = row
+            if data_type in ('STRING', 'CHARACTER VARYING'):
+                if max_length is not None:
+                    field_class = partial(CharField, max_length=max_length)
+                else:
+                    field_class = TextField
+            elif data_type == 'TIMESTAMP':
