+class QueryEvent(object):
+    """
+    Representa um evento de consulta SQL executada.
+    
+    Atributos:
+        sql (str): Texto SQL executado
+        params (tuple/list): Parâmetros passados para a execução
+        duration (float): Tempo de execução em segundos (>= 0)
+        exception (Exception or None): Exceção ocorrida, se houver
+    """
+    __slots__ = ('sql', 'params', 'duration', 'exception')
+    
+    def __init__(self, sql, params, duration, exception):
+        self.sql = sql
+        self.params = params
+        self.duration = duration
+        self.exception = exception
+
+
 class ConnectionContext(_callable_context_manager):
