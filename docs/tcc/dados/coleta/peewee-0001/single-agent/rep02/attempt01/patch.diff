     def init(self, database, **kwargs):
@@ -3890,11 +3910,31 @@ class Database(_callable_context_manager):
         if logger.isEnabledFor(logging.DEBUG):
             logger.debug((sql, params))
 
+    def _notify_query_hooks(self, sql, params, duration, exception):
+        if not self.query_hooks:
+            return
+        event = QueryEvent(sql, params, duration, exception)
+        for hook in self.query_hooks:
+            try:
+                hook(event)
+            except Exception:
+                # Erro no gancho é propagado para o chamador
+                raise
+
     def execute_sql(self, sql, params=None):
         self._log_query(sql, params)
-        with __exception_wrapper__:
-            cursor = self.cursor()
-            cursor.execute(sql, params or ())
+        start_time = time.time()
+        exception = None
+        try:
+            with __exception_wrapper__:
+                cursor = self.cursor()
+                cursor.execute(sql, params or ())
+        except Exception as exc:
+            exception = exc
+            raise
+        finally:
+            duration = time.time() - start_time
+            self._notify_query_hooks(sql, params or (), duration, exception)
         return cursor
 
     def execute(self, query, **context_options):
