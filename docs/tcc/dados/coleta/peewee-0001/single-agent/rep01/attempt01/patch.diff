+    def _notify_query_hooks(self, sql, params, duration, exception):
+        """
+        Notify all registered query hooks about a SQL execution.
+        
+        Args:
+            sql (str): The SQL text executed.
+            params (tuple/list): Parameters passed to the execution.
+            duration (float): Execution time in seconds.
+            exception (Exception): Exception raised during execution, or None.
+        """
+        if not self.query_hooks:
+            return
+            
+        event = QueryEvent(sql, params, duration, exception)
+        for hook in self.query_hooks:
+            try:
+                hook(event)
+            except Exception:
+                # Re-raise exceptions from hooks
+                raise
