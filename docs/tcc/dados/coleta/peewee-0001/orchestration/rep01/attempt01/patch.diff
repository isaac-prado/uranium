+class QueryEvent(object):
+    """
+    Represents information about a SQL query execution.
+    
+    Attributes:
+        sql (str): The SQL statement that was executed
+        params (tuple/list/dict): Parameters passed to the query
+        duration (float): Time taken to execute the query in seconds
+        exception (Exception): Any exception raised during execution, or None
+    """
+    __slots__ = ('sql', 'params', 'duration', 'exception')
+
+    def __init__(self, sql, params, duration, exception):
+        self.sql = sql
+        self.params = params
+        self.duration = duration
+        self.exception = exception
+
