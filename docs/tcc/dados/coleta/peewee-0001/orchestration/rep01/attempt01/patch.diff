+    def _call_query_hooks(self, sql, params, duration, exception):
+        """Call all registered query hooks with query execution information."""
+        if not self.query_hooks:
+            return
+            
+        event = QueryEvent(sql, params, duration, exception)
+        for hook in self.query_hooks:
+            try:
+                hook(event)
+            except Exception:
+                # If a hook raises an exception, log it but continue with other hooks
+                logger.exception("Query hook raised an exception")
+
