 T = TypeVar("T")
 
 
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Remove duplicate keys maintaining order and applying suffix _N starting at 2.
+    
+    For example:
+    - ["id", "id", "name"] becomes ["id", "id_2", "name"]
+    - ["text", "text"] becomes ["text", "text_2"]
+    
+    :param keys: List of string keys that may contain duplicates
+    :return: List of unique keys with duplicates suffixed
+    """
+    # Track what we've added to the result to avoid collisions
+    result_so_far = set()
+    result = []
+    
+    for key in keys:
+        if key in result_so_far:
+            # Need to create a new unique key
+            counter = 2
+            new_key = f"{key}_{counter}"
+            while new_key in result_so_far:
+                counter += 1
+                new_key = f"{key}_{counter}"
+            result.append(new_key)
+            result_so_far.add(new_key)
+        else:
+            # Key is unique, add it directly
+            result.append(key)
+            result_so_far.add(key)
+    return result
+
+
 class _CloseableIterator(Iterator[Row]):
