+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    De-duplicate a list of keys, preserving order.
+    
+    If a key appears twice, the second instance will be renamed key_2,
+    the third key_3, and so on. If key_2 already exists, it will be
+    renamed key_3, and so on.
+    
+    Examples:
+    
+    >>> dedupe_keys(['a', 'b', 'c'])
+    ['a', 'b', 'c']
+    >>> dedupe_keys(['a', 'b', 'a', 'c'])
+    ['a', 'b', 'a_2', 'c']
+    >>> dedupe_keys(['a', 'b', 'a', 'a'])
+    ['a', 'b', 'a_2', 'a_3']
+    >>> dedupe_keys(['a', 'b', 'a_2', 'a'])
+    ['a', 'b', 'a_2', 'a_3']
+    >>> dedupe_keys(['a', 'b', 'a_2', 'a', 'a_2'])
+    ['a', 'b', 'a_2', 'a_3', 'a_2_2']
+    """
+    seen: Dict[str, int] = {}
+    existing_keys: Set[str] = set()
+    new_keys: List[str] = []
+    
+    for key in keys:
+        if key in existing_keys:
+            # Key already exists, need to deduplicate
+            counter = seen.get(key, 1) + 1
+            candidate = f"{key}_{counter}"
+            while candidate in existing_keys:
+                counter += 1
+                candidate = f"{key}_{counter}"
+            new_keys.append(candidate)
+            seen[key] = counter
+            existing_keys.add(candidate)
+        else:
+            # Key is unique so far
+            new_keys.append(key)
+            existing_keys.add(key)
+            seen[key] = 1
+    
+    return new_keys
+
+
