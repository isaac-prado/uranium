diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..fff698c 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,49 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list with duplicates renamed to avoid conflicts.
+    
+    When a column name appears more than once, the first occurrence keeps its original name,
+    and subsequent occurrences get suffixed with _N where N starts at 2 and increases until
+    a unique name is found.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+        
+    :param keys: List of column names that may contain duplicates
+    :return: List of unique column names
+    """
+    if not keys:
+        return []
+    
+    # All existing names that could cause conflicts
+    existing_names: Set[str] = set(keys)
+    result: List[str] = []
+    used_names: Set[str] = set()
+    
+    for key in keys:
+        if key not in used_names:
+            # First occurrence, keep as is
+            result.append(key)
+            used_names.add(key)
+        else:
+            # Duplicate, need to find a new name
+            counter = 2
+            new_key = f"{key}_{counter}"
+            while new_key in existing_names or new_key in used_names:
+                counter += 1
+                new_key = f"{key}_{counter}"
+            result.append(new_key)
+            used_names.add(new_key)
+            
+    return result
