+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Remove duplicate keys by adding numeric suffixes to duplicates.
+    
+    Each repeated key gets a suffix _N where N starts at 2 and increases
+    until the name doesn't collide with any existing key.
+    
+    Examples:
+    [] -> []
+    ["id", "name"] -> ["id", "name"]
+    ["id", "id"] -> ["id", "id_2"]
+    ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+    ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+    ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+    ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    
+    :param keys: List of column names that may contain duplicates
+    :return: List of column names with duplicates renamed
+    """
+    if not keys:
+        return []
+        
+    # Create a set of all existing keys for fast lookup
+    existing_keys = set(keys)
+    
+    # Track which new names we've already assigned
+    assigned_names = set()
+    
+    result = []
+    counts = {}  # Track how many times each original key has been seen
+    
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+        
+        if counts[key] == 1:
+            # First occurrence, keep as is
+            result.append(key)
+            assigned_names.add(key)
+        else:
+            # Duplicate, need to rename
+            # Start with _2 and increment until we find an unused name
+            suffix = 2
+            new_key = f"{key}_{suffix}"
+            
+            # Keep incrementing until we find a name that doesn't conflict
+            while new_key in existing_keys or new_key in assigned_names:
+                suffix += 1
+                new_key = f"{key}_{suffix}"
+                
+            result.append(new_key)
+            assigned_names.add(new_key)
+            
+    return result
