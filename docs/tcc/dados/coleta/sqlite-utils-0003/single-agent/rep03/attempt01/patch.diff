+def decode_base64_values(item):
+    """
+    Recursively decode base64-encoded values in a dictionary or list.
+    
+    Looks for dictionaries with structure {"$base64": True, "encoded": "..."}
+    and replaces them with the decoded bytes.
+    
+    :param item: Dictionary, list, or other value to process
+    :return: Processed item with base64 values decoded
+    """
+    if isinstance(item, dict):
+        # Check if this is a base64-encoded value
+        if item.get("$base64") is True and "encoded" in item:
+            encoded = item["encoded"]
+            if isinstance(encoded, str):
+                try:
+                    return base64.b64decode(encoded)
+                except Exception:
+                    # If decoding fails, return the original item
+                    return item
+            else:
+                return item
+        else:
+            # Recursively process dictionary values
+            # First check if any values need to be decoded
+            needs_decoding = False
+            processed_items = {}
+            for key, value in item.items():
+                processed_value = decode_base64_values(value)
+                processed_items[key] = processed_value
+                if processed_value is not value:
+                    needs_decoding = True
+            
+            # Return original item if nothing changed
+            if not needs_decoding:
+                return item
+            return processed_items
+    elif isinstance(item, list):
+        # Recursively process list items
+        # First check if any items need to be decoded
+        needs_decoding = False
+        processed_items = []
+        for value in item:
+            processed_value = decode_base64_values(value)
+            processed_items.append(processed_value)
+            if processed_value is not value:
+                needs_decoding = True
+        
+        # Return original item if nothing changed
+        if not needs_decoding:
+            return item
+        return processed_items
+    else:
+        # Return other values unchanged
+        return item
 
 
