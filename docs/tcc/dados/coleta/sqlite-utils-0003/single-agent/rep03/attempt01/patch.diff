+def column_affinity(column_type):
+    """
+    Determine the affinity of a column based on its declared type.
+    
+    SQLite has specific rules for determining column affinity based on 
+    the declared type name.
+    
+    :param column_type: String representing the declared column type
+    :return: Affinity as a string ("INTEGER", "TEXT", "REAL", "BLOB", "NUMERIC")
+    """
+    if column_type is None:
+        return "NUMERIC"
+        
+    column_type = column_type.upper()
+    
+    # Rule 1: If the declared type contains the string "INT"
+    if "INT" in column_type:
+        return "INTEGER"
+        
+    # Rule 2: If the declared type contains any of these strings
+    if any(s in column_type for s in ("CHAR", "CLOB", "TEXT")):
+        return "TEXT"
+        
+    # Rule 3: If the declared type contains "BLOB" or no type is specified
+    if "BLOB" in column_type:
+        return "BLOB"
+        
+    # Rule 4: If the declared type contains any of these strings
+    if any(s in column_type for s in ("REAL", "FLOA", "DOUB")):
+        return "REAL"
+        
+    # Rule 5: Otherwise
+    return "NUMERIC"
+
