+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Remove duplicate keys by adding numeric suffixes starting from 2.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+        
+    :param keys: List of column names that may contain duplicates
+    :return: List of column names with duplicates renamed with numeric suffixes
+    """
+    if not keys:
+        return []
+    
+    # Create a set of all existing keys for quick lookup
+    existing_keys = set(keys)
+    result = []
+    # Keep track of how many times we've seen each base key
+    seen_count = {}
+    
+    for key in keys:
+        if key not in seen_count:
+            seen_count[key] = 1
+            result.append(key)
+        else:
+            seen_count[key] += 1
+            # Find the first available suffix
+            suffix_num = 2
+            new_key = f"{key}_{suffix_num}"
+            while new_key in existing_keys or new_key in result:
+                suffix_num += 1
+                new_key = f"{key}_{suffix_num}"
+            result.append(new_key)
+            
+    return result
