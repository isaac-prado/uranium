+def suggest_column_types(records):
+    """
+    Given a list of records, suggest the best column types for each field.
+    
+    :param records: List of dictionaries representing records
+    :return: Dictionary mapping field names to suggested types
+    """
+    if not records:
+        return {}
+    
+    # Get all unique keys from all records
+    all_keys = set()
+    for record in records:
+        all_keys.update(record.keys())
+    
+    # Initialize type suggestions for each key
+    column_types = {}
+    for key in all_keys:
+        column_types[key] = None
+    
+    # For each record, determine the best type for each field
+    for record in records:
+        for key, value in record.items():
+            if value is None:
+                continue
+            
+            current_type = column_types[key]
+            
+            # Determine the type of the current value
+            if isinstance(value, bool):
+                value_type = int  # SQLite doesn't have bool, treat as int
+            elif isinstance(value, int):
+                value_type = int
+            elif isinstance(value, float):
+                value_type = float
+            elif isinstance(value, bytes):
+                value_type = bytes
+            else:
+                value_type = str  # Default to string for everything else
+            
+            # Update the column type based on the hierarchy:
+            # None -> any type
+            # int -> float (if needed)
+            # float -> str (if needed)
+            # bytes -> str (if needed)
+            if current_type is None:
+                column_types[key] = value_type
+            elif current_type == int and value_type == float:
+                column_types[key] = float
+            elif current_type in (int, float, bytes) and value_type == str:
+                column_types[key] = str
+    
+    # Replace None with str as default
+    for key in column_types:
+        if column_types[key] is None:
+            column_types[key] = str
+            
+    return column_types
