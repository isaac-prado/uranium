+def _compile_code(code, imports=None, variable="value"):
+    """
+    Compile Python code into a function.
+    
+    :param code: Python code to compile
+    :param imports: List of import statements
+    :param variable: Name of the variable to use in the function signature
+    :return: Compiled function
+    """
+    if imports is None:
+        imports = []
+    
+    # Combine imports and code
+    full_code = "\n".join(imports) + "\n" + code if imports else code
+    
+    # Compile the code
+    compiled = compile(full_code, "<string>", "exec")
+    
+    # Create a function wrapper
+    func_code = f"def fn({variable}):\n"
+    for line in full_code.splitlines():
+        func_code += f"    {line}\n"
+    
+    # Add a return statement if the code doesn't already have one
+    if "return" not in full_code:
+        func_code += f"    return {variable}\n"
+    
+    # Compile the function
+    func_compiled = compile(func_code, "<string>", "exec")
+    
+    # Execute in a local namespace and return the function
+    namespace = {}
+    exec(func_compiled, namespace)
+    return namespace["fn"]
 
