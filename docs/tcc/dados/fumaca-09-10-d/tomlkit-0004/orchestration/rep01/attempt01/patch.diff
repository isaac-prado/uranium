+    def _parse_dotted_key(self):  # type: () -> Key
+        """
+        Parses a dotted key.
+        """
+        keys = []
+        while True:
+            # Parse a single key part
+            if self._current in "\"'":
+                key_part = self._parse_quoted_key()
+            else:
+                key_part = self._parse_bare_key()
+            
+            keys.append(key_part)
+            
+            # Check if there's another part
+            if self._current == ".":
+                self.inc()  # Skip the dot
+                # Skip whitespace
+                while self._current.is_spaces() and self.inc():
+                    pass
+            else:
+                break
+        
+        # For dotted keys, we return the full key string as the key
+        # and store the individual parts in a special attribute
+        full_key = ".".join([k.key for k in keys])
+        result = Key(full_key, sep="")
+        result._dotted_parts = keys
+        return result
+
