+        # Look ahead to see if we have a dotted key
+        has_dot = False
+        in_string = False
+        string_delim = None
+        
+        while not self.end() and self._current not in "= \t\n\r#":
+            if self._current in "\"'":
+                if not in_string:
+                    in_string = True
+                    string_delim = self._current
+                elif self._current == string_delim:
+                    in_string = False
+                    string_delim = None
+            elif self._current == "." and not in_string:
+                has_dot = True
+                break
+            self.inc()
+        
+        # Restore position
+        self._restore_idx(*saved_idx)
+        self.mark()
