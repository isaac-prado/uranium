+    def _parse_dotted_key(self):  # type: () -> Key
+        """
+        Parses a dotted key (TOML 0.5.0 feature).
+        """
+        saved_idx = self._save_idx()
+        self.mark()
+        parts = []
+        
+        try:
+            while True:
+                # Parse a key part (bare or quoted)
+                if self._current in "\"'":
+                    part_key = self._parse_quoted_key()
+                else:
+                    # Check if current character is valid for bare key
+                    if not self._current.is_bare_key_char():
+                        # Not a valid dotted key part, return None to indicate failure
+                        self._restore_idx(*saved_idx)
+                        return None
+                    part_key = self._parse_bare_key()
+                
+                parts.append(part_key)
+                
+                # Check if next character is a dot
+                if self._current != ".":
+                    break
+                    
+                # Skip the dot
+                self.inc()
+                
+                # After the dot, we must have another key part
+                if self.end() or not (self._current.is_bare_key_char() or self._current in "\"'"):
+                    # Invalid: dot at end or followed by invalid character
+                    raise self.parse_error(UnexpectedCharError, (self._current if not self.end() else "."))
+
+            # If we only have one part, it's not a dotted key
+            if len(parts) == 1:
+                # Restore index since this wasn't actually a dotted key
+                self._restore_idx(*saved_idx)
+                return None
+                
+            # For dotted keys, we return a special key that represents the full path
+            full_key = ".".join([p.key for p in parts])
+            return Key(full_key, sep="")
+        except:
+            # If any error occurs, restore index and return None
+            self._restore_idx(*saved_idx)
+            return None
+
