+    def _handle_dotted_key(self, key: DottedKey, item: Item) -> None:
+        """
+        Handle a dotted key by creating the appropriate nested table structure.
+        """
+        names = tuple(iter(key))
+        name = names[0]
+        name._dotted = True
+        
+        # Check if the first part already exists
+        if name in self:
+            # If it exists and we're not dealing with a table, we need to create nested structure
+            if not isinstance(item, Table):
+                table = Table(Container(True), Trivia(), False, is_super_table=True)
+                _table = table
+                for i, _name in enumerate(names[1:]):
+                    if i == len(names) - 2:  # Last element
+                        _name.sep = key.sep
+                        _table.append(_name, item)
+                    else:
+                        _name._dotted = True
+                        new_table = Table(
+                            Container(True),
+                            Trivia(),
+                            False,
+                            is_super_table=i < len(names) - 2,
+                        )
+                        _table.append(_name, new_table)
+                        _table = new_table
+                        
+                # Replace the existing item with our new structure
+                self._replace(name, name, table)
+            else:
+                # If it's a table, just append normally
+                self.append(name, item)
+        else:
+            # If the first part doesn't exist, create the nested structure
+            table = Table(Container(True), Trivia(), False, is_super_table=True)
+            _table = table
+            
+            for i, _name in enumerate(names[1:]):
+                if i == len(names) - 2:  # Last element
+                    _name.sep = key.sep
+                    _table.append(_name, item)
+                else:
+                    _name._dotted = True
+                    new_table = Table(
+                        Container(True),
+                        Trivia(),
+                        False,
+                        is_super_table=i < len(names) - 2,
+                    )
+                    _table.append(_name, new_table)
+                    _table = new_table
+                    
+            # Add the constructed table structure
+            self.append(name, table)
+
