 T = TypeVar("T")
 
 
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list with duplicates renamed with numeric suffixes.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+    
+    # Count occurrences of each key
+    counts: Dict[str, int] = {}
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+    
+    # Track how many times we've used each base key
+    used_counts: Dict[str, int] = {}
+    result = []
+    
+    for key in keys:
+        if counts[key] == 1:
+            # Unique key, no change needed
+            result.append(key)
+        else:
+            # Duplicate key, need to add suffix
+            used_count = used_counts.get(key, 0) + 1
+            used_counts[key] = used_count
+            
+            if used_count == 1:
+                # First occurrence stays as-is
+                result.append(key)
+            else:
+                # Subsequent occurrences get suffixed
+                new_key = f"{key}_{used_count}"
+                # Handle potential conflicts with existing keys
+                counter = used_count
+                while new_key in used_counts or new_key in counts:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                used_counts[new_key] = 1
+                result.append(new_key)
+                
+    return result
+
+
