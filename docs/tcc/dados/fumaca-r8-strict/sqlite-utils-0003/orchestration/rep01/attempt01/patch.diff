+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate keys by appending _2, _3 etc to duplicates.
+    
+    Examples:
+    [] -> []
+    ['id', 'name'] -> ['id', 'name']
+    ['id', 'id'] -> ['id', 'id_2']
+    ['id', 'id', 'id'] -> ['id', 'id_2', 'id_3']
+    ['id', 'id', 'id_2'] -> ['id', 'id_3', 'id_2']
+    ['id_2', 'id', 'id'] -> ['id_2', 'id', 'id_3']
+    ['id', 'id', 'id_2', 'id_2'] -> ['id', 'id_3', 'id_2', 'id_2_2']
+    """
+    if not keys:
+        return keys
+    
+    # Count occurrences of each key
+    counts: Dict[str, int] = {}
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+
+    # For keys that appear more than once, we need to rename them
+    # Keep track of how many times we've seen each base name
+    seen_counts: Dict[str, int] = {}
+    result: List[str] = []
+    
+    for key in keys:
+        if counts[key] == 1:
+            # Unique key, no change needed
+            result.append(key)
+            seen_counts[key] = 1
+        else:
+            # Duplicate key, need to handle renaming
+            seen_count = seen_counts.get(key, 0) + 1
+            seen_counts[key] = seen_count
+            
+            if seen_count == 1:
+                # First occurrence, keep original name
+                result.append(key)
+            else:
+                # Subsequent occurrences, add suffix
+                new_key = f"{key}_{seen_count}"
+                # Handle case where the new_key might conflict with an existing key
+                counter = seen_count
+                while new_key in counts or new_key in seen_counts:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result.append(new_key)
+                seen_counts[new_key] = 1  # Mark this new key as seen
+                
+    return result
+
+
