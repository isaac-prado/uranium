+    def _handle_dotted_key(self, container, key_parts, final_key, value):
+        """
+        Handles dotted keys by creating nested tables as needed.
+        """
+        from .items import Table, Trivia, Key
+        from .container import Container
+        from .exceptions import KeyAlreadyPresent
+        
+        current_container = container
+        # Navigate/create intermediate tables
+        for i, part in enumerate(key_parts[:-1]):  # All parts except the last one
+            part_key = part.key
+            print(f"DEBUG: Processing part {i}: {part_key}")
+            print(f"DEBUG: part in current_container: {part in current_container}")
+            print(f"DEBUG: part_key in current_container: {part_key in current_container}")
+            if part not in current_container:
+                print(f"DEBUG: Creating new table for {part_key}")
+                # Create new super table
+                new_table = Table(
+                    Container(),
+                    Trivia("", "", "", ""),
+                    False,
+                    is_super_table=True,
+                    name=part_key
+                )
+                current_container.append(part, new_table)
+                current_container = new_table.value
+            else:
+                print(f"DEBUG: Table {part_key} already exists")
+                existing_item = current_container[part_key]
+                print(f"DEBUG: Existing item type: {type(existing_item)}")
+                if isinstance(existing_item, Table):
+                    current_container = existing_item.value
+                    # Make sure it's a super table so we can add more items
+                    if not existing_item.is_super_table():
+                        # Convert to super table
+                        existing_item._is_super_table = True
+                else:
+                    # This shouldn't happen in valid TOML
+                    key_obj = Key(part_key)
+                    raise KeyAlreadyPresent(key_obj)
+
+        # Add the final key-value pair to the last table
+        print(f"DEBUG: Adding final key {final_key.key} to container")
+        current_container.append(final_key, value)
+
+    def _split_dotted_key(self):  # type: () -> Generator[Key]
+        """
+        Splits a dotted key from the current position.
+        """
+        in_name = False
+        delim = None
+        current = ""
+        t = KeyType.Bare
+        start_pos = self._idx
+        
+        while not self.end():
+            c = self._current
+
+            if c == ".":
+                if in_name:
+                    current += c
+                    self.inc()
+                    continue
+
+                if not current:
+                    raise self.parse_error()
+
+                yield Key(current, t=t, sep="")
+
+                current = ""
+                t = KeyType.Bare
+                self.inc()
+                # Skip whitespace after dot
+                while not self.end() and self._current.is_spaces():
+                    self.inc()
+                continue
+            elif c in {"'", '"'}:
+                if in_name:
+                    if t == KeyType.Literal and c == '"':
+                        current += c
+                        self.inc()
+                        continue
+
+                    if c != t.value:
+                        raise self.parse_error()
+
+                    in_name = False
+                    self.inc()
+                else:
+                    in_name = True
+                    t = KeyType.Literal if c == "'" else KeyType.Basic
+                    self.inc()
+
+                continue
+            elif in_name or c.is_bare_key_char():
+                current += c
+                self.inc()
+            elif c.is_spaces() or c == '=':
+                # End of key
+                break
+            else:
+                raise self.parse_error(UnexpectedCharError, (c))
+
+        if current:
+            yield Key(current, t=t, sep="")
+        
+        # If we haven't consumed the key yet, do it now
+        if self._idx == start_pos and current:
+            # Advance to the end of the key
+            while not self.end() and not (self._current.is_spaces() or self._current == '='):
+                self.inc()
