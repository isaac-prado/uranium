+    def _insert_dotted_key(self, key, value, container):
+        """
+        Insert a dotted key into the container, creating nested structures as needed.
+        """
+        # Check if this is actually a dotted key
+        if key is None or "." not in key.key:
+            # Not a dotted key, insert normally
+            container.append(key, value)
+            return
+            
+        # Check if the key is a quoted string (not a dotted key)
+        # If the entire key is quoted, it's not a dotted key
+        stripped_key = key.key.strip()
+        if ((stripped_key.startswith('"') and stripped_key.endswith('"') and stripped_key.count('"') == 2 and stripped_key[1:-1].count('"') == 0) or \
+           (stripped_key.startswith("'") and stripped_key.endswith("'") and stripped_key.count("'") == 2 and stripped_key[1:-1].count("'") == 0)):
+            # This is a quoted key, not a dotted key
+            container.append(key, value)
+            return
+            
+        # Split the key by dots, respecting quoted strings
+        try:
+            key_parts = list(self._split_table_name(key.key))
+        except:
+            # If we can't split it properly, treat as regular key
+            container.append(key, value)
+            return
+        
+        if len(key_parts) == 1:
+            # Not a dotted key after splitting, insert normally
+            container.append(key, value)
+            return
+            
+        # Handle dotted key by creating nested structure
+        current_container = container
+        for i, part in enumerate(key_parts[:-1]):
+            part_str = part.key
+            if part_str not in current_container:
+                # Create new table for this part
+                new_table = Table(
+                    Container(),
+                    value.trivia if value.trivia is not None else Trivia(),
+                    False,  # is_aot_element
+                    is_super_table=True,
+                    name=part_str
+                )
+                current_container.append(part_str, new_table)
+                current_container = new_table
+            else:
+                existing = current_container[part_str]
+                if isinstance(existing, Table):
+                    current_container = existing
+                else:
+                    # This part already exists as a non-table value, which is an error
+                    raise self.parse_error(ParseError, ("Cannot overwrite existing value with table",))
+        
+        # Set the final value
+        final_key = key_parts[-1]
+        current_container.append(final_key.key, value)
+
