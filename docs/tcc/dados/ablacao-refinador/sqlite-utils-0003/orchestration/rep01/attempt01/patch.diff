diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..a14f901 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,50 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Renames duplicate keys by appending numeric suffixes (_2, _3, etc.)
+    
+    When a key appears multiple times, the first occurrence keeps its original name,
+    and subsequent occurrences are renamed with a suffix starting from _2.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+        
+    :param keys: List of column names that may contain duplicates
+    :return: List of column names with duplicates renamed
+    """
+    if not keys:
+        return []
+    
+    # Create a working copy
+    result = list(keys)
+    # Keep track of all names we've seen so far
+    seen_names = set()
+    
+    # Process each position
+    for i in range(len(result)):
+        current_key = result[i]
+        # Check if this key has been seen before
+        if current_key in seen_names:
+            # Need to rename this key
+            counter = 2
+            new_key = f"{current_key}_{counter}"
+            # Make sure the new key doesn't conflict with existing keys
+            while new_key in seen_names or new_key in result[i+1:]:
+                counter += 1
+                new_key = f"{current_key}_{counter}"
+            result[i] = new_key
+            seen_names.add(new_key)
+        else:
+            seen_names.add(current_key)
+    
+    return result
