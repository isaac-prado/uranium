@@ -254,6 +259,52 @@ class Container(_CustomDict):
 
         return self
 
+    def _handle_dotted_key_structure(self, key: Key, value: Item) -> None:
+        """
+        For dotted keys, also create the nested table structure to allow
+        accessing values as doc['foo']['bar'] in addition to the direct
+        dotted key access.
+        """
+        from .items import Table
+        from .items import Trivia
+        from .container import Container as ItemsContainer
+        
+        names = tuple(iter(key))
+        if len(names) < 2:
+            return
+            
+        # Create nested table structure that mimics what the parser creates
+        first_name = names[0].key
+        first_key = names[0]
+        first_key._dotted = True
+        
+        # Only create the structure if it doesn't exist yet
+        if first_name not in self:
+            # Create a super table for the first part
+            table = Table(ItemsContainer(True), Trivia(), False, is_super_table=True)
+            # Add it using the internal mechanism to avoid double registration
+            self._map[first_key] = len(self._body)
+            self._body.append((first_key, table))
+            dict.__setitem__(self, first_name, table)
+            
+            # Build the nested structure
+            current_table = table
+            for i, _name in enumerate(names[1:]):
+                if i == len(names) - 2:
+                    # Last name - set the actual value
+                    _name.sep = key.sep
+                    current_table.append(_name, value)
+                else:
+                    _name._dotted = True
+                    new_table = Table(
+                        ItemsContainer(True),
+                        Trivia(),
+                        False,
+                        is_super_table=True,
+                    )
+                    current_table.append(_name, new_table)
+                    current_table = new_table
+
     def remove(self, key: Union[Key, str]) -> "Container":
         if not isinstance(key, Key):
             key = SingleKey(key)
