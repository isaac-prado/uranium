diff --git a/src/attr/_funcs.py b/src/attr/_funcs.py
index 518be16..33c3372 100644
--- a/src/attr/_funcs.py
+++ b/src/attr/_funcs.py
@@ -296,7 +296,16 @@ def has(cls):
 
     :rtype: bool
     """
-    return getattr(cls, "__attrs_attrs__", None) is not None
+    # Check if cls itself has __attrs_attrs__
+    if getattr(cls, "__attrs_attrs__", None) is not None:
+        return True
+    
+    # Check if cls is a generic alias (e.g., Caixa[str]) and its origin has __attrs_attrs__
+    origin = getattr(cls, "__origin__", None)
+    if origin is not None:
+        return getattr(origin, "__attrs_attrs__", None) is not None
+    
+    return False
 
 
