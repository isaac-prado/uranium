diff --git a/src/attr/_funcs.py b/src/attr/_funcs.py
index 518be16..652c673 100644
--- a/src/attr/_funcs.py
+++ b/src/attr/_funcs.py
@@ -296,6 +296,19 @@ def has(cls):
 
     :rtype: bool
     """
+    import typing
+    
+    # For generic aliases (e.g., Caixa[str]), check the origin class
+    # typing.get_origin was added in Python 3.8
+    if hasattr(typing, "get_origin"):
+        origin = typing.get_origin(cls)
+    else:
+        # Fallback for Python < 3.8
+        origin = getattr(cls, "__origin__", None)
+    
+    if origin is not None:
+        cls = origin
+    
     return getattr(cls, "__attrs_attrs__", None) is not None
 
 
