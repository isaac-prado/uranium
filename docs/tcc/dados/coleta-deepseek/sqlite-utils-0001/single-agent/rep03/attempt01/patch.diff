+    def _check_destructive_foreign_keys_in_transaction(self) -> None:
+        """
+        Check if this table has destructive foreign key references while in a transaction.
+        Raises TransactionError if foreign keys are enabled, we're in a transaction,
+        and there are destructive foreign key references to this table.
+        """
+        pragma_foreign_keys_was_on = bool(
+            self.db.execute("PRAGMA foreign_keys").fetchone()[0]
+        )
+        already_in_transaction = self.db.conn.in_transaction
+        
+        if pragma_foreign_keys_was_on and already_in_transaction:
+            destructive_refs = []
+            for table_name in self.db.table_names():
+                table = self.db[table_name]
+                for fk in table.foreign_keys:
+                    if fk.other_table == self.name and fk.on_delete.upper() in ("CASCADE", "SET NULL", "SET DEFAULT"):
+                        destructive_refs.append((table_name, fk.on_delete.upper()))
+            
+            if destructive_refs:
+                refs_info = ", ".join(
+                    f"{table} (ON DELETE {action})"
+                    for table, action in destructive_refs
+                )
+                raise TransactionError(
+                    f"Cannot transform or drop table '{self.name}' while in a transaction "
+                    f"because it is referenced by destructive foreign keys: {refs_info}. "
+                    f"Either perform the operation outside of a transaction or "
+                    f"temporarily disable foreign keys with PRAGMA foreign_keys=OFF."
+                )
+
     @property
     def count(self) -> int:
         "Count of the rows in this table - optionally from the table count cache, if configured."
