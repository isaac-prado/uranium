@@ -254,6 +261,81 @@ class Container(_CustomDict):
 
         return self
 
+    def _append_dotted_key(self, key: Key, item: Item) -> "Container":
+        """Handle dotted keys by creating nested tables."""
+        names = tuple(iter(key))
+        if not names:
+            raise ValueError("Dotted key must have at least one part")
+        
+        first_name = names[0]
+        first_name._dotted = True
+        
+        # Check if the first part already exists
+        if first_name in self:
+            existing = self[first_name]
+            if not isinstance(existing, Table):
+                raise KeyAlreadyPresent(first_name)
+            
+            # Existing table, need to add nested keys
+            current_table = existing
+            for i, name in enumerate(names[1:]):
+                if i == len(names) - 2:
+                    # Last part, set the separator and add the value
+                    name.sep = key.sep
+                    # Don't mark last part as dotted
+                    return current_table.value.append(name, item)
+                else:
+                    # Intermediate part, mark as dotted
+                    name._dotted = True
+                    # Intermediate part, ensure table exists
+                    if name in current_table.value:
+                        next_table = current_table.value[name]
+                        if not isinstance(next_table, Table):
+                            raise KeyAlreadyPresent(name)
+                        current_table = next_table
+                    else:
+                        # Create intermediate table
+                        new_table = Table(
+                            Container(parsed=self._parsed),
+                            Trivia(),
+                            False,
+                            is_super_table=True
+                        )
+                        current_table.value.append(name, new_table)
+                        current_table = new_table
+        else:
+            # Create new nested table structure
+            table = Table(
+                Container(parsed=self._parsed),
+                Trivia(),
+                False,
+                is_super_table=True
+            )
+            # Mark the key as dotted and append
+            self.append(first_name, table)
+            
+            current_table = table
+            for i, name in enumerate(names[1:]):
+                if i == len(names) - 2:
+                    # Last part, set the separator and add the value
+                    name.sep = key.sep
+                    # Don't mark last part as dotted
+                    return current_table.value.append(name, item)
+                else:
+                    # Intermediate part, mark as dotted
+                    name._dotted = True
+                    # Create intermediate table
+                    new_table = Table(
+                        Container(parsed=self._parsed),
+                        Trivia(),
+                        False,
+                        is_super_table=True
+                    )
+                    current_table.value.append(name, new_table)
+                    current_table = new_table
+        
+        return self
+
     def remove(self, key: Union[Key, str]) -> "Container":
