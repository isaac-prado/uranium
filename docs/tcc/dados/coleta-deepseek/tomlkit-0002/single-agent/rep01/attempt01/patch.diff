+    def _handle_dotted_key(self, key: Key, item: Item) -> None:
+        """Handle dotted keys by creating nested tables."""
+        if not key.is_dotted():
+            return
+
+        names = list(key)
+        current = self
+        
+        # Create nested tables for all but the last part
+        for i, name in enumerate(names[:-1]):
+            if name in current:
+                # Already exists, navigate into it
+                current_item = current[name]
+                if isinstance(current_item, Table):
+                    # Only mark as dotted if not parsed (i.e., created by API)
+                    if not self._parsed:
+                        for k, v in current._body:
+                            if k == name:
+                                k._dotted = True
+                                break
+                    current = current_item.value
+                elif isinstance(current_item, AoT):
+                    # This shouldn't happen for dotted keys
+                    raise KeyAlreadyPresent(f"Cannot add dotted key through AoT at {name}")
+                else:
+                    # Conflict: non-table value where we need a table
+                    raise KeyAlreadyPresent(name)
+            else:
+                # Create new table
+                # Mark as super table since it's created from a dotted key
+                table = Table(Container(True), Trivia(), False, is_super_table=True)
+                # Add the table first
+                current.append(name, table)
+                # Mark the key as dotted if not parsed
+                if not self._parsed:
+                    for k, v in current._body:
+                        if k == name:
+                            k._dotted = True
+                            break
+                current = table.value
+        
+        # Add the actual value with the last key part
+        last_name = names[-1]
+        last_name.sep = key.sep
+        # Clear the dotted flag for the last key since it's not dotted itself
+        last_name._dotted = False
+        current.append(last_name, item)
+
