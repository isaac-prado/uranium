+    def _add_dotted_key(self, key: Key, item: Item) -> "Container":
+        """Handle adding a dotted key by creating nested tables."""
+        # Convert item if needed
+        if not isinstance(item, Item):
+            item = _item(item)
+        
+        names = tuple(iter(key))
+        
+        # Mark all parts as dotted
+        for name in names:
+            name._dotted = True
+        
+        name = names[0]
+        
+        if name in self:
+            # First part already exists
+            if not isinstance(self[name], Table):
+                raise KeyAlreadyPresent(name)
+            
+            table = self[name]
+        else:
+            # First part doesn't exist, create table
+            table = Table(Container(True), Trivia(), False, is_super_table=True)
+            # Add the table using raw append to avoid dotted key handling
+            self._raw_append(name, table)
+        
+        # Now navigate through or create the nested structure
+        current_table = table
+        for i, _name in enumerate(names[1:]):
+            if i == len(names) - 2:
+                # Last part, add the value
+                _name.sep = key.sep
+                # Add the value to the current table
+                return current_table.value.append(_name, item)
+            else:
+                # Intermediate part, ensure table exists
+                if _name in current_table.value:
+                    if not isinstance(current_table.value[_name], Table):
+                        raise KeyAlreadyPresent(_name)
+                    current_table = current_table.value[_name]
+                else:
+                    new_table = Table(Container(True), Trivia(), False, is_super_table=True)
+                    # Use raw append to avoid dotted key handling
+                    current_table.value._raw_append(_name, new_table)
+                    current_table = new_table
+        return self
+    
+    def _raw_append(self, key: Key, item: Item) -> None:
+        """Append an item without checking for dotted keys."""
+        # Simplified version of append that doesn't handle dotted keys
+        if not isinstance(item, Item):
+            item = _item(item)
+        
+        if isinstance(item, (AoT, Table)) and item.name is None:
+            item.name = key.key
+        
+        prev = self._previous_item()
+        prev_ws = isinstance(prev, Whitespace) or ends_with_withespace(prev)
+        if isinstance(item, Table):
+            if item.name != key.key:
+                item.invalidate_display_name()
+            if self._body and not (self._parsed or item.trivia.indent or prev_ws):
+                item.trivia.indent = "\n"
+        
+        if isinstance(item, AoT) and self._body and not self._parsed:
+            item.invalidate_display_name()
+            if item and not ("\n" in item[0].trivia.indent or prev_ws):
+                item[0].trivia.indent = "\n" + item[0].trivia.indent
+        
+        self._map[key] = len(self._body)
+        self._body.append((key, item))
+        if item.is_table():
+            self._table_keys.append(key)
