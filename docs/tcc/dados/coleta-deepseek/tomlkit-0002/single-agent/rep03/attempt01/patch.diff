+    
+
+    def _handle_dotted_key(self, key: "DottedKey", value: Item) -> "Container":
+        """Handle dotted keys by creating nested structure, similar to parser."""
+        from .items import Table, Trivia
+        
+        names = list(iter(key))
+        if len(names) == 0:
+            raise ValueError("DottedKey must have at least one part")
+        
+        first_key = names[0]
+        # Mark first key as dotted so it renders correctly
+        first_key._dotted = True
+        
+        if first_key in self:
+            # First level already exists
+            current = self[first_key]
+            if len(names) == 1:
+                # Single key, replace value
+                return self._replace(first_key, value)
+            
+            # Navigate through existing structure
+            for i, name in enumerate(names[1:]):
+                if i == len(names) - 2:
+                    # Last key, set the value
+                    name.sep = key.sep
+                    if isinstance(current, Table):
+                        return current.value.append(name, value)
+                    else:
+                        # current is a Container
+                        return current.append(name, value)
+                else:
+                    # Intermediate key
+                    name._dotted = True
+                    if name in current:
+                        current = current[name]
+                    else:
+                        # Create new intermediate table
+                        new_table = Table(Container(True), Trivia(), False, is_super_table=True)
+                        if isinstance(current, Table):
+                            current.value.append(name, new_table)
+                        else:
+                            current.append(name, new_table)
+                        current = new_table
+        else:
+            # First level doesn't exist, create whole structure
+            if len(names) == 1:
+                # Single dotted key (unusual but possible)
+                return self.append(first_key, value)
+            else:
+                # Create nested structure
+                table = Table(Container(True), Trivia(), False, is_super_table=True)
+                current = table
+                
+                for i, name in enumerate(names[1:]):
+                    if i == len(names) - 2:
+                        # Last key
+                        name.sep = key.sep
+                        current.value.append(name, value)
+                    else:
+                        # Intermediate key
+                        name._dotted = True
+                        next_table = Table(Container(True), Trivia(), False, is_super_table=True)
+                        current.value.append(name, next_table)
+                        current = next_table
+                
+                return self.append(first_key, table)
+
     def __repr__(self) -> str:
         return repr(self.value)
 
