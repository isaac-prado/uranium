+    def _handle_dotted_key(self, container, key, value):  # type: (Container, Key, Item) -> None
+        """
+        Handle dotted keys by creating nested tables.
+        """
+        # Split the dotted key into parts
+        parts = []
+        current = ""
+        in_quotes = False
+        quote_char = None
+        
+        for char in key.key:
+            if char in "\"'":
+                if not in_quotes:
+                    in_quotes = True
+                    quote_char = char
+                    current += char
+                elif char == quote_char:
+                    in_quotes = False
+                    current += char
+                else:
+                    current += char
+            elif char == "." and not in_quotes:
+                if current:
+                    parts.append(current)
+                    current = ""
+            else:
+                current += char
+        
+        if current:
+            parts.append(current)
+        
+        # Create or navigate to nested containers
+        current_container = container
+        for i, part in enumerate(parts):
+            is_last = i == len(parts) - 1
+            
+            # Parse the part to determine if it's quoted
+            if part.startswith('"') and part.endswith('"'):
+                part_key = Key(part[1:-1], KeyType.Basic, "")
+            elif part.startswith("'") and part.endswith("'"):
+                part_key = Key(part[1:-1], KeyType.Literal, "")
+            else:
+                part_key = Key(part, sep="")
+            
+            if is_last:
+                # Last part is the actual key
+                current_container.append(part_key, value)
+            else:
+                # Intermediate part should be a table
+                if part_key not in current_container:
+                    # Create a new table
+                    table = Table(Container(), Trivia(), False, False, is_dotted=True)
+                    current_container.append(part_key, table)
+                
+                # Navigate to the next container
+                current_container = current_container[part_key]
+
