+    def _parse_dotted_key(self):  # type: () -> Key
+        """
+        Parses a dotted key (may be a single key or multiple keys separated by dots).
+        Returns a Key with the combined key string (without quotes for individual parts)
+        but stores the original parts as metadata for serialization.
+        """
+        parts = []
+        while True:
+            # Parse one key part
+            if self._current in "\"'":
+                key = self._parse_quoted_key()
+            else:
+                key = self._parse_bare_key()
+            
+            parts.append(key)
+            
+            # Check if there's a dot for next part
+            if self._current == ".":
+                self.inc()  # Skip the dot
+                # Skip whitespace after dot? According to TOML spec, no whitespace allowed between dots and key parts
+                continue
+            else:
+                break
+        
+        # Combine all parts into a single dotted key string WITHOUT quotes
+        # This is for dictionary key access
+        dotted_key_parts = []
+        for k in parts:
+            dotted_key_parts.append(k.key)  # k.key already has quotes removed
+        
+        dotted_key = ".".join(dotted_key_parts)
+        
+        # Create the key but store original parts for serialization
+        result = Key(dotted_key, sep=parts[-1].sep if parts else "")
+        
+        # Store original parts as an attribute for serialization
+        # We need to know which parts were quoted
+        result._original_parts = parts
+        
+        return result
 
