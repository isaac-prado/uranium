+    def _append_dotted_key(self, container, key, value):  # type: (Container, Key, Item) -> None
+        """
+        Append a value using a dotted key, creating nested tables as needed.
+        """
+        # Handle None key (whitespace or comment)
+        if key is None:
+            # For whitespace or comments, just append to container
+            container.append(key, value)
+            return
+        
+        # Check if key has original parts - this indicates it's a dotted key
+        # Dotted keys should be processed even if they contain dots
+        if hasattr(key, '_original_parts'):
+            # This is a dotted key, process it
+            pass
+        elif key.t != KeyType.Bare:
+            # Quoted keys with dots are NOT dotted keys
+            # They are single keys with dots in their name
+            container.append(key, value)
+            return
+        
+        # Check if key has dots
+        if '.' not in key.key:
+            container.append(key, value)
+            return
+        
+        # Get the parts - use original parts if available
+        if hasattr(key, '_original_parts'):
+            parts = [part.key for part in key._original_parts]
+        else:
+            parts = key.key.split('.')
+        current_container = container
+        
+        # Create nested tables for all parts except the last
+        for i, part in enumerate(parts[:-1]):
+            # Create a key for this part
+            part_key = Key(part)
+            
+            # Check if this part already exists
+            if part_key in current_container:
+                # Get the actual item, not its value
+                idx = current_container._map.get(part_key)
+                if idx is not None:
+                    existing_item = current_container._body[idx][1]
+                else:
+                    # Should not happen if part_key in current_container
+                    existing_item = current_container[part_key]
+                
+                # If it's a table, use its value (the inner container)
+                if isinstance(existing_item, Table):
+                    current_container = existing_item.value
+                # If it's a container (already a nested container), use it
+                elif isinstance(existing_item, Container):
+                    current_container = existing_item
+                # If it's a value, we have a conflict
+                else:
+                    # According to TOML spec, this is an error
+                    # A dotted key cannot redefine a simple key
+                    raise KeyAlreadyPresent(part_key)
+            else:
+                # Create a new table for this part
+                new_table = Table(Container(), Trivia(), False, is_super_table=True)
+                current_container.append(part_key, new_table)
+                current_container = new_table.value
+        
+        # Add the value with the last part as key
+        last_key = Key(parts[-1])
+        current_container.append(last_key, value)
+
