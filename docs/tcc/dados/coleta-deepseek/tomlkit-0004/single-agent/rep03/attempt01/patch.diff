+class DottedKeyTable(Table):
+    """
+    A table created from a dotted key (e.g., a.b.c = 1).
+    Stores the original key parts for serialization.
+    """
+
+    def __init__(self, value, key_parts, trivia):  # type: (Item, List[Key], Trivia) -> None
+        # Create a container with the value at the nested location
+        container = Container()
+        current = container
+        
+        # Create nested structure
+        for i, part_key in enumerate(key_parts[:-1]):
+            part_key_str = part_key.key
+            # Create nested table
+            table = Table(Container(), Trivia("", "", "", ""), 
+                         False, name=part_key_str, is_super_table=True)
+            current._map[part_key] = len(current._body)
+            current._body.append((part_key, table))
+            super(Container, current).__setitem__(part_key_str, table.value)
+            current = table.value
+        
+        # Add the actual value at the last key
+        last_key = key_parts[-1]
+        last_key_str = last_key.key
+        current._map[last_key] = len(current._body)
+        current._body.append((last_key, value))
+        super(Container, current).__setitem__(last_key_str, value.value)
+        
+        # Initialize as a table
+        super(DottedKeyTable, self).__init__(
+            container, trivia, False, is_super_table=True, 
+            name=key_parts[0].key
+        )
+        
+        self._key_parts = key_parts
+        self._original_value = value
+
+    @property
+    def key_parts(self):  # type: () -> List[Key]
+        return self._key_parts
+
+    def as_string(self):  # type: () -> str
+        # Serialize as dotted key
+        key_str = ".".join(part.as_string() for part in self._key_parts)
+        return "{}{}{}".format(key_str, self._key_parts[0].sep, self._original_value.as_string())
+
