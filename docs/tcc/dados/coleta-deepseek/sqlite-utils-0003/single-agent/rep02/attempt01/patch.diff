diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..233ac2f 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,51 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list with duplicates renamed
+    by adding numeric suffixes.
+
+    The first occurrence of a name stays unchanged. Each subsequent occurrence
+    gets a suffix _N where N starts at 2 and increments until the name does
+    not collide with any other name in the output (original or already renamed).
+
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+
+    :param keys: List of column names, possibly with duplicates
+    :return: List of same length with duplicates renamed
+    """
+    result = []
+    # Track all names that are already taken (original or renamed)
+    taken = set()
+    
+    # First pass: collect all original names
+    original_names = set(keys)
+    
+    for key in keys:
+        if key not in taken:
+            # First occurrence of this name
+            result.append(key)
+            taken.add(key)
+        else:
+            # Duplicate: need to find a new name
+            n = 2
+            while True:
+                candidate = f"{key}_{n}"
+                # Check if candidate collides with any original name or already taken name
+                if candidate not in original_names and candidate not in taken:
+                    result.append(candidate)
+                    taken.add(candidate)
+                    break
+                n += 1
+    
+    return result
