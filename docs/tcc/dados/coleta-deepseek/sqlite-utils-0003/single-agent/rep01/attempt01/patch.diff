+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list with duplicates renamed
+    by adding numeric suffixes (_2, _3, ...) to ensure uniqueness.
+    
+    The first occurrence of a name remains unchanged. Subsequent duplicates
+    are renamed to avoid collisions with any existing names (original or
+    already renamed).
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    
+    :param keys: List of column names (may contain duplicates)
+    :return: List of deduplicated column names
+    """
+    result = []
+    # Track all names that have been used (original or renamed)
+    used_names = set()
+    
+    # First pass: collect all original names to avoid using them as suffixes
+    original_names = set(keys)
+    
+    for key in keys:
+        if key not in used_names:
+            # First occurrence - keep as is
+            result.append(key)
+            used_names.add(key)
+        else:
+            # Duplicate - find a unique name
+            n = 2
+            while True:
+                candidate = f"{key}_{n}"
+                # Check if candidate is not used AND is not an original name
+                # (unless it's the same original name we're trying to rename)
+                if candidate not in used_names and (candidate not in original_names or candidate == key):
+                    result.append(candidate)
+                    used_names.add(candidate)
+                    break
+                n += 1
+    
+    return result
+
+
