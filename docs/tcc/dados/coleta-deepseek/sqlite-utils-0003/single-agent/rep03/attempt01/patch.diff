diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..58b5713 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,47 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list with duplicates renamed
+    by adding numeric suffixes (_2, _3, ...) to ensure uniqueness.
+
+    The first occurrence of each name is kept as-is. Subsequent duplicates
+    are renamed with the smallest available numeric suffix that doesn't
+    conflict with any existing name (original or already renamed).
+
+    :param keys: List of column names, possibly with duplicates
+    :return: List of deduplicated column names in the same order
+    """
+    result = []
+    # Track all names we've seen (original or renamed)
+    used_names = set()
+    
+    # First pass: collect all original names to check conflicts
+    all_original_names = set(keys)
+    
+    for key in keys:
+        if key not in used_names:
+            # First occurrence - keep as-is if it doesn't conflict
+            # with a future name that would need this exact name
+            result.append(key)
+            used_names.add(key)
+        else:
+            # Duplicate - find available suffix
+            # We need to find a suffix that doesn't conflict with:
+            # 1. Already used names (in used_names)
+            # 2. Original names that appear later in the list
+            suffix = 2
+            while True:
+                candidate = f"{key}_{suffix}"
+                # Check if candidate conflicts with any original name
+                # that hasn't been processed yet
+                if candidate not in used_names and candidate not in all_original_names:
+                    result.append(candidate)
+                    used_names.add(candidate)
+                    break
+                suffix += 1
+    
+    return result
