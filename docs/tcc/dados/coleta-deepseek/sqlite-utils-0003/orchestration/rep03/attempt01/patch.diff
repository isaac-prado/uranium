diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..2833c02 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,76 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Deduplicate a list of column names by adding numeric suffixes to duplicates.
+
+    The first occurrence of a name remains unchanged. Subsequent occurrences
+    receive suffixes _2, _3, etc., skipping any suffix that would collide with
+    an existing name in the original list or a name already assigned to a
+    duplicate.
+
+    Examples:
+        >>> dedupe_keys([])
+        []
+        >>> dedupe_keys(["id", "name"])
+        ["id", "name"]
+        >>> dedupe_keys(["id", "id"])
+        ["id", "id_2"]
+        >>> dedupe_keys(["id", "id", "id"])
+        ["id", "id_2", "id_3"]
+        >>> dedupe_keys(["id", "id", "id_2"])
+        ["id", "id_3", "id_2"]
+        >>> dedupe_keys(["id_2", "id", "id"])
+        ["id_2", "id", "id_3"]
+        >>> dedupe_keys(["id", "id", "id_2", "id_2"])
+        ["id", "id_3", "id_2", "id_2_2"]
+
+    :param keys: List of column names, possibly with duplicates
+    :return: Deduplicated list with suffixes added to duplicates
+    """
+    result: List[str] = []
+    # Track all names that are already taken (assigned names)
+    taken: Set[str] = set()
+    # Track names that exist in the original list (including duplicates)
+    original_names = set(keys)
+    # For each base name, track the count of occurrences
+    occurrence_count: Dict[str, int] = {}
+    
+    for key in keys:
+        # Update occurrence count
+        if key not in occurrence_count:
+            occurrence_count[key] = 0
+        occurrence_count[key] += 1
+        
+        # For the first occurrence of a base name
+        if occurrence_count[key] == 1:
+            # Check if the base name is available
+            if key not in taken and key not in original_names.difference({key}):
+                # Base name is available (not taken and no other occurrence in original)
+                result.append(key)
+                taken.add(key)
+            else:
+                # Base name is not available, find suffix
+                suffix = 2
+                while True:
+                    candidate = f"{key}_{suffix}"
+                    if candidate not in taken and candidate not in original_names:
+                        result.append(candidate)
+                        taken.add(candidate)
+                        break
+                    suffix += 1
+        else:
+            # Duplicate occurrence, always use a suffix
+            suffix = 2
+            while True:
+                candidate = f"{key}_{suffix}"
+                if candidate not in taken and candidate not in original_names:
+                    result.append(candidate)
+                    taken.add(candidate)
+                    break
+                suffix += 1
+    
+    return result
