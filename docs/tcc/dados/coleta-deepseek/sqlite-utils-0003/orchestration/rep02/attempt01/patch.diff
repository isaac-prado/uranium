diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..4119dc7 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,57 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Deduplicate a list of column names, preserving order.
+
+    When a column name appears more than once, the first occurrence keeps the
+    original name. Subsequent occurrences receive a numeric suffix _N (starting
+    at 2) that does not collide with any other column name in the list.
+
+    Examples::
+
+        dedupe_keys([]) -> []
+        dedupe_keys(['id', 'name']) -> ['id', 'name']
+        dedupe_keys(['id', 'id']) -> ['id', 'id_2']
+        dedupe_keys(['id', 'id', 'id']) -> ['id', 'id_2', 'id_3']
+        dedupe_keys(['id', 'id', 'id_2']) -> ['id', 'id_3', 'id_2']
+        dedupe_keys(['id_2', 'id', 'id']) -> ['id_2', 'id', 'id_3']
+        dedupe_keys(['id', 'id', 'id_2', 'id_2']) -> ['id', 'id_3', 'id_2', 'id_2_2']
+
+    :param keys: List of column names, possibly with duplicates
+    """
+    result: List[str] = []
+    # Keep track of all names already used (original and renamed)
+    used_names: Set[str] = set()
+    # Count occurrences of each original name
+    name_counts: Dict[str, int] = {}
+    
+    # First pass: collect all original names
+    for key in keys:
+        name_counts[key] = name_counts.get(key, 0) + 1
+    
+    # Second pass: process names
+    for key in keys:
+        if key not in used_names:
+            # First occurrence keeps the original name
+            result.append(key)
+            used_names.add(key)
+        else:
+            # Duplicate: needs numeric suffix
+            # Try suffixes starting at 2
+            suffix = 2
+            while True:
+                candidate = f"{key}_{suffix}"
+                # Check if candidate would collide with:
+                # 1. An original name in the list
+                # 2. A name already used in result
+                if candidate not in name_counts and candidate not in used_names:
+                    result.append(candidate)
+                    used_names.add(candidate)
+                    break
+                suffix += 1
+    
+    return result
