diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..607de67 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,57 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Rename duplicate column names by adding numeric suffixes (_2, _3, etc.),
+    avoiding collisions with existing names and preserving order.
+    
+    Examples:
+        >>> dedupe_keys(['id', 'name'])
+        ['id', 'name']
+        >>> dedupe_keys(['id', 'id'])
+        ['id', 'id_2']
+        >>> dedupe_keys(['id', 'id', 'id'])
+        ['id', 'id_2', 'id_3']
+        >>> dedupe_keys(['id', 'id', 'id_2'])
+        ['id', 'id_3', 'id_2']
+        >>> dedupe_keys(['id_2', 'id', 'id'])
+        ['id_2', 'id', 'id_3']
+        >>> dedupe_keys(['id', 'id', 'id_2', 'id_2'])
+        ['id', 'id_3', 'id_2', 'id_2_2']
+    
+    :param keys: List of column names as returned by SQLite
+    :return: List of deduplicated column names
+    """
+    result = []
+    seen = {}
+    
+    for key in keys:
+        if key not in seen:
+            # First occurrence, keep as is
+            result.append(key)
+            seen[key] = 1
+        else:
+            # Duplicate, need to find a new name
+            count = seen[key]
+            # Try to find an available suffix
+            while True:
+                # Start with _2 for the second occurrence
+                suffix = f"_{count + 1}" if count > 0 else "_2"
+                candidate = f"{key}{suffix}"
+                
+                # Check if candidate already exists in original keys
+                # or has been used already
+                if candidate not in keys and candidate not in result:
+                    result.append(candidate)
+                    seen[key] = count + 1
+                    break
+                else:
+                    # Candidate exists, try next number
+                    count += 1
+            # Update count for next duplicate of this key
+            seen[key] = count + 1
+    
+    return result
