     @Node.copy
     def window(self, *windows):
+        if windows:
+            # Verificar aliases duplicados
+            aliases = []
+            for w in windows:
+                if hasattr(w, '_alias'):
+                    aliases.append(w._alias)
+            
+            # Verificar duplicados
+            seen = set()
+            duplicates = set()
+            for alias in aliases:
+                if alias in seen:
+                    duplicates.add(alias)
+                else:
+                    seen.add(alias)
+            
+            if duplicates:
+                raise ValueError('Window aliases must be unique. Duplicate alias(es): %s' % 
+                               ', '.join(sorted(duplicates)))
+        
         self._windows = windows if windows else None
 
