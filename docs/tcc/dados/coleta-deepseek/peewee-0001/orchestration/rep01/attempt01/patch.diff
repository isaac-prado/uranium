@@ -3727,6 +3727,21 @@ class ConnectionContext(_callable_context_manager):
         return type(self)(self.db)
 
 
+class QueryEvent:
+    """Evento de execução de consulta SQL."""
+    __slots__ = ('sql', 'params', 'duration', 'exception')
+    
+    def __init__(self, sql, params, duration, exception):
+        self.sql = sql
+        self.params = params
+        self.duration = duration
+        self.exception = exception
+    
+    def __repr__(self):
+        return '<QueryEvent sql=%r params=%r duration=%r exception=%r>' % (
+            self.sql, self.params, self.duration, self.exception)
+
+
 class Database(_callable_context_manager):
     context_class = Context
     field_types = {}
@@ -3787,6 +3802,7 @@ class Database(_callable_context_manager):
                            'database driver you are using.')
 
         self.connect_params = {}
+        self.query_hooks = []  # Lista de ganchos para observar execuções SQL
         self.init(database, **kwargs)
 
     def init(self, database, **kwargs):
@@ -3892,9 +3908,29 @@ class Database(_callable_context_manager):
 
     def execute_sql(self, sql, params=None):
         self._log_query(sql, params)
-        with __exception_wrapper__:
-            cursor = self.cursor()
-            cursor.execute(sql, params or ())
+        start_time = time.time()
+        exception = None
+        cursor = None
+        
+        try:
+            with __exception_wrapper__:
+                cursor = self.cursor()
+                cursor.execute(sql, params or ())
+        except Exception as e:
+            exception = e
+            raise
+        finally:
+            duration = time.time() - start_time
+            event = QueryEvent(sql, params, duration, exception)
+            
+            # Chamar hooks na ordem de registro
+            for hook in self.query_hooks:
+                try:
+                    hook(event)
+                except Exception as hook_exc:
+                    # Se um hook levantar exceção, propagamos
+                    raise hook_exc from exception if exception else None
+            
         return cursor
 
     def execute(self, query, **context_options):
