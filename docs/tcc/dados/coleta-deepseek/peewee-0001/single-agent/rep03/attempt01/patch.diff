@@ -3632,6 +3632,21 @@ class OperationalError(DatabaseError): pass
 class ProgrammingError(DatabaseError): pass
 
 
+class QueryEvent:
+    """Evento representando uma execução de query SQL."""
+    __slots__ = ('sql', 'params', 'duration', 'exception')
+    
+    def __init__(self, sql, params, duration, exception):
+        self.sql = sql
+        self.params = params
+        self.duration = duration
+        self.exception = exception
+    
+    def __repr__(self):
+        return (f'<QueryEvent sql={self.sql!r} params={self.params!r} '
+                f'duration={self.duration:.6f} exception={self.exception}>')
+
+
 class ExceptionWrapper(object):
     __slots__ = ('exceptions',)
     def __init__(self, exceptions):
@@ -3787,6 +3802,7 @@ class Database(_callable_context_manager):
                            'database driver you are using.')
 
         self.connect_params = {}
+        self.query_hooks = []
         self.init(database, **kwargs)
 
     def init(self, database, **kwargs):
@@ -3892,9 +3908,32 @@ class Database(_callable_context_manager):
 
     def execute_sql(self, sql, params=None):
         self._log_query(sql, params)
-        with __exception_wrapper__:
-            cursor = self.cursor()
-            cursor.execute(sql, params or ())
+        start = time.time()
+        exception = None
+        cursor = None
+        
+        try:
+            with __exception_wrapper__:
+                cursor = self.cursor()
+                cursor.execute(sql, params or ())
+        except Exception as exc:
+            exception = exc
+            raise
+        finally:
+            duration = time.time() - start
+            event = QueryEvent(sql, params, duration, exception)
+            for hook in self.query_hooks:
+                try:
+                    hook(event)
+                except Exception:
+                    # Se um hook levantar exceção, ela deve ser propagada
+                    # ao chamador de execute_sql
+                    if exception is None:
+                        # Se a query original não falhou, propaga a exceção do hook
+                        raise
+                    # Se já havia uma exceção da query, mantém a original
+                    pass
+        
         return cursor
 
     def execute(self, query, **context_options):
