+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list where any duplicates are renamed
+    with a numeric suffix to ensure uniqueness. The first occurrence remains unchanged,
+    subsequent ones get a suffix like '_2', '_3', etc. The suffix is chosen to avoid
+    conflicts with existing column names.
+
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+
+    :param keys: A list of column names (strings)
+    :return: A new list of unique column names
+    """
+    if not keys:
+        return []
+
+    # Count occurrences of each key to know which ones are duplicated
+    key_counts = {}
+    for key in keys:
+        key_counts[key] = key_counts.get(key, 0) + 1
+
+    # Track which new names we've already used to avoid conflicts
+    used_names = set(keys)  # Start with all original names as used
+    result = []
+
+    # Keep track of how many times we've seen each base key for suffixing
+    suffix_counters = {}
+
+    for key in keys:
+        if key_counts[key] == 1:
+            # Unique key, no change needed
+            result.append(key)
+        else:
+            # Duplicate key, check if it's the first occurrence
+            count_so_far = suffix_counters.get(key, 0)
+            if count_so_far == 0:
+                # First occurrence of a duplicate key, keep as-is
+                result.append(key)
+                suffix_counters[key] = 1
+            else:
+                # Subsequent occurrence, add a suffix
+                counter = count_so_far + 1
+                new_key = f"{key}_{counter}"
+                # Keep incrementing until we find a name not in use
+                while new_key in used_names:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result.append(new_key)
+                used_names.add(new_key)
+                suffix_counters[key] = counter
+                
+    return result
+
