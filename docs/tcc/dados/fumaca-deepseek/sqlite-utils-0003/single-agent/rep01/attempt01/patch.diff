diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..40aaa26 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,62 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Deduplicate a list of column names by adding numeric suffixes to duplicates.
+    
+    The first occurrence of a name stays as-is. Each subsequent duplicate gets
+    a suffix _N where N starts at 2 and increments until the name doesn't collide
+    with any other name in the final list (including names already assigned to
+    previous duplicates).
+    
+    :param keys: List of column names, possibly with duplicates
+    :return: List of same length with deduplicated names
+    """
+    result = []
+    # All unique names from the original list
+    original_names = set(keys)
+    # Names already used in the result (original or generated)
+    used = set()
+    # Track how many times we've seen each key
+    seen_count = {}
+    
+    for key in keys:
+        seen_count[key] = seen_count.get(key, 0) + 1
+        count = seen_count[key]
+        
+        if count == 1:
+            # First occurrence of this key
+            if key not in used:
+                # Can use the key as-is
+                result.append(key)
+                used.add(key)
+            else:
+                # Key is already used (by a generated name from a previous duplicate)
+                # Need to generate a new name
+                n = 2
+                while True:
+                    candidate = f"{key}_{n}"
+                    # Candidate must not collide with any original name
+                    # or any name already used
+                    if candidate not in original_names and candidate not in used:
+                        result.append(candidate)
+                        used.add(candidate)
+                        break
+                    n += 1
+        else:
+            # Subsequent occurrence - needs a suffix
+            n = 2
+            while True:
+                candidate = f"{key}_{n}"
+                # Candidate must not collide with any original name
+                # or any name already used
+                if candidate not in original_names and candidate not in used:
+                    result.append(candidate)
+                    used.add(candidate)
+                    break
+                n += 1
+    
+    return result
