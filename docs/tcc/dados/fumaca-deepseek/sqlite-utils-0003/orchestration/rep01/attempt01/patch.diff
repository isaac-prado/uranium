diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..46e2a4b 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,50 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Deduplicate a list of column names by adding numeric suffixes to duplicates.
+
+    The first occurrence of a name remains unchanged. Subsequent duplicates
+    receive suffixes _2, _3, etc., skipping any names that are already present
+    in the output list (including those that were originally present with suffixes).
+
+    Examples:
+        >>> dedupe_keys(['id', 'name'])
+        ['id', 'name']
+        >>> dedupe_keys(['id', 'id'])
+        ['id', 'id_2']
+        >>> dedupe_keys(['id', 'id', 'id'])
+        ['id', 'id_2', 'id_3']
+        >>> dedupe_keys(['id', 'id', 'id_2'])
+        ['id', 'id_3', 'id_2']
+        >>> dedupe_keys(['id_2', 'id', 'id'])
+        ['id_2', 'id', 'id_3']
+        >>> dedupe_keys(['id', 'id', 'id_2', 'id_2'])
+        ['id', 'id_3', 'id_2', 'id_2_2']
+
+    :param keys: List of column names, possibly with duplicates
+    :return: List of deduplicated column names preserving order
+    """
+    result: List[str] = []
+    # Incluir todas as chaves originais no conjunto de nomes ocupados
+    occupied: Set[str] = set(keys)
+    
+    for key in keys:
+        if key not in result:
+            # Primeira ocorrência - manter como está
+            result.append(key)
+        else:
+            # Duplicata - encontrar um nome único com sufixo
+            n = 2
+            while True:
+                candidate = f"{key}_{n}"
+                if candidate not in occupied:
+                    result.append(candidate)
+                    occupied.add(candidate)
+                    break
+                n += 1
+    
+    return result
