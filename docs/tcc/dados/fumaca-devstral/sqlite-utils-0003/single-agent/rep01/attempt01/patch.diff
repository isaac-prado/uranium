diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..831538a 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,51 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(column_names: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list with duplicate names
+    made unique by appending _2, _3, etc. to each duplicate after the first.
+    
+    The first occurrence of a name is kept as-is. Each subsequent occurrence
+    gets a numeric suffix starting from 2, incrementing until a name is found
+    that doesn't conflict with any existing name (original or already suffixed).
+    
+    :param column_names: List of column names, possibly with duplicates
+    :return: List of unique column names in the same order
+    """
+    # First, collect all names that will be in the final result
+    # to check for conflicts when generating suffixed names
+    all_names = set()
+    # Track how many times each base name appears
+    name_counts = {}
+    
+    for name in column_names:
+        if name in name_counts:
+            name_counts[name] += 1
+        else:
+            name_counts[name] = 1
+        all_names.add(name)
+    
+    # Now generate the result
+    result = []
+    used_names = set()
+    
+    for name in column_names:
+        if name not in used_names:
+            # First occurrence, use as-is
+            result.append(name)
+            used_names.add(name)
+        else:
+            # Find the next available suffix
+            counter = 2
+            while True:
+                new_name = f"{name}_{counter}"
+                if new_name not in all_names and new_name not in used_names:
+                    result.append(new_name)
+                    used_names.add(new_name)
+                    break
+                counter += 1
+    
+    return result
