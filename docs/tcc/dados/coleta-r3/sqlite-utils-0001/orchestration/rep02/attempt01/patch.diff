+def _detect_destructive_references(db, table_name):
+    """
+    Detect tables that reference `table_name` with destructive foreign key actions.
+    
+    Returns a list of tuples (referencing_table, action) where action is one of
+    'CASCADE', 'SET NULL', 'SET DEFAULT'.
+    """
+    destructive_actions = {"CASCADE", "SET NULL", "SET DEFAULT"}
+    referencing_tables_with_actions = []
+    
+    # Get all table names
+    table_names_query = "SELECT name FROM sqlite_master WHERE type='table'"
+    for row in db.execute(table_names_query).fetchall():
+        referencing_table = row[0]
+        # Get foreign key info for this table
+        fk_info_query = f"PRAGMA foreign_key_list('{referencing_table}')"
+        for fk_row in db.execute(fk_info_query).fetchall():
+            # fk_row is a tuple like (id, seq, table, from, to, on_update, on_delete, match)
+            # We're interested in the 'table' (index 2) and 'on_delete' (index 6)
+            referenced_table = fk_row[2]
+            on_delete_action = fk_row[6].upper()
+            
+            if referenced_table == table_name and on_delete_action in destructive_actions:
+                referencing_tables_with_actions.append((referencing_table, on_delete_action))
+                
+    return referencing_tables_with_actions
+
