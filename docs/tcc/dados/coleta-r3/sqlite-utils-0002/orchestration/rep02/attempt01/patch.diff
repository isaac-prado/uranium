+def _guess_format(fp: BinaryIO) -> Format:
+    # Guess the format from the filename
+    name = getattr(fp, "name", None)
+    if name:
+        if name.endswith(".csv"):
+            return Format.CSV
+        elif name.endswith(".tsv"):
+            return Format.TSV
+        elif name.endswith(".json"):
+            return Format.JSON
+        elif name.endswith(".nl"):
+            return Format.NL
+    # fallback to CSV
+    return Format.CSV
 
 
