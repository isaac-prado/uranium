+    def _handle_dotted_key(self, key, value, container):
+        """
+        Handle dotted keys by creating nested tables automatically.
+        
+        For example: key="a.b.c", value="value" creates:
+        [a]
+        [a.b] 
+        a.b.c = "value"
+        """
+        # Check if key contains dots (and not just quoted dots)
+        # Only handle dotted keys for bare keys that contain dots
+        if "." in key.key and key.t == KeyType.Bare:
+            # Split the dotted key
+            parts = list(self._split_dotted_key(key.key))
+            
+            if len(parts) > 1:
+                # Create nested structure
+                current_container = container
+                
+                # Navigate/create intermediate tables
+                for part in parts[:-1]:
+                    if part.key not in current_container:
+                        # Create new table
+                        from .items import Table, Trivia
+                        from .container import Container
+                        new_table = Table(Container(), Trivia("", "", "", ""), False, is_super_table=True)
+                        current_container.append(part, new_table)
+                        current_container = new_table.value
+                    else:
+                        existing = current_container[part.key]
+                        if hasattr(existing, 'value') and hasattr(existing.value, 'body'):
+                            # It's already a table
+                            current_container = existing.value
+                        else:
+                            # Convert existing value to table
+                            raise self.parse_error(ValueError, "Cannot convert existing key '{}' to table".format(part.key))
+                
+                # Set the final value
+                final_key = parts[-1]
+                current_container.append(final_key, value)
+                return True
+        
+        return False
+
