+    def _split_dotted_key(self, name):  # type: (str) -> Generator[Key]
+        """
+        Split a dotted key into its components.
+        
+        For example: "a.b.c" -> ["a", "b", "c"]
+        Quoted parts are preserved: 'a."b.c".d' -> ["a", "b.c", "d"]
+        """
+        in_name = False
+        in_quotes = False
+        current = ""
+        quote_char = None
+        
+        i = 0
+        while i < len(name):
+            c = name[i]
+            
+            if c in {'"', "'"} and not in_quotes:
+                # Start of quoted section
+                in_quotes = True
+                quote_char = c
+                current += c
+            elif c == quote_char and in_quotes:
+                # End of quoted section
+                in_quotes = False
+                current += c
+                quote_char = None
+            elif c == "." and not in_quotes:
+                # Dot outside quotes - end of component
+                if current:
+                    yield Key(current.strip(), sep="")
+                    current = ""
+                else:
+                    raise self.parse_error()
+            else:
+                current += c
+            
+            i += 1
+        
+        if current:
+            yield Key(current.strip(), sep="")
