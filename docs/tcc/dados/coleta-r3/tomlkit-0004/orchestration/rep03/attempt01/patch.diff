+    def _handle_dotted_key(self, container, key, value):  # type: (Container, Key, Item) -> None:
+        """
+        Handles dotted keys by creating nested table structures.
+        """
+        # Split the dotted key into parts using the existing method
+        parts = list(self._split_table_name(key.key))
+        
+        # Navigate/create the nested structure
+        current_container = container
+        for i, part in enumerate(parts[:-1]):
+            # Check if this part already exists
+            if part.key in current_container:
+                item = current_container[part.key]
+                # If it's not a table, we can't nest further
+                if not isinstance(item, Table):
+                    raise self.parse_error(UnexpectedCharError, part.key)
+                current_container = item.value
+            else:
+                # Create a new super table
+                from .container import Container as InnerContainer
+                from .items import Trivia
+                new_container = InnerContainer()
+                new_table = Table(new_container, Trivia(indent="", comment_ws="", comment="", trail=""), 
+                                 is_aot_element=False, is_super_table=True, name=part.key)
+                current_container.append(part.key, new_table)
+                current_container = new_container
+                
+        # Add the final value to the deepest container
+        final_part = parts[-1]
+        current_container.append(final_part.key, value)
+
