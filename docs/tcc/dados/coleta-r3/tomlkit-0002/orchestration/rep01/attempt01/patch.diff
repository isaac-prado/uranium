         if not isinstance(key, Key) and key is not None:
             key = SingleKey(key)
 
+        # Handle dotted keys by creating the appropriate table structure
+        if isinstance(key, DottedKey):
+            # Reuse the same logic as the parser
+            names = tuple(iter(key))
+            name = names[0]
+            name._dotted = True
+            
+            if name in self:
+                if not isinstance(self[name], Table):
+                    # Convert existing non-table item to a super table to hold nested structure
+                    table = Table(Container(True), Trivia(), False, is_super_table=True)
+                    _table = table
+                    for i, _name in enumerate(names[1:]):
+                        if i == len(names) - 2:
+                            _name.sep = key.sep
+                            _table.append(_name, item)
+                        else:
+                            _name._dotted = True
+                            _table.append(
+                                _name,
+                                Table(
+                                    Container(True),
+                                    Trivia(),
+                                    False,
+                                    is_super_table=i < len(names) - 2,
+                                ),
+                            )
+                            _table = _table[_name]
+                    
+                    # Replace the existing item with our new table structure
+                    if isinstance(self, Table):
+                        self.raw_append(name, table)
+                    else:
+                        self.append(name, table)
+                    return self
+                else:
+                    # Existing item is already a table, navigate through it
+                    table = self[name]
+                    for i, _name in enumerate(names[1:]):
+                        if i == len(names) - 2:
+                            # Last part - set the actual value
+                            _name.sep = key.sep
+                            table.append(_name, item)
+                            return self
+                        else:
+                            # Intermediate parts
+                            _name._dotted = True
+                            if _name not in table:
+                                new_table = Table(Container(True), Trivia(), False, is_super_table=True)
+                                table.append(_name, new_table)
+                            table = table[_name]
+                    return self
+                    
+            # First part doesn't exist, create the full structure from scratch
+            table = Table(Container(True), Trivia(), False, is_super_table=True)
+            if isinstance(self, Table):
+                self.raw_append(name, table)
+            else:
+                self.append(name, table)
+            
+            # Navigate/create the nested structure
+            for i, _name in enumerate(names[1:]):
+                if i == len(names) - 2:
+                    # Last part - set the actual value
+                    _name.sep = key.sep
+                    table.append(_name, item)
+                    return self
+                else:
+                    # Intermediate parts
+                    _name._dotted = True
+                    new_table = Table(Container(True), Trivia(), False, is_super_table=True)
+                    table.append(_name, new_table)
+                    table = table[_name]
