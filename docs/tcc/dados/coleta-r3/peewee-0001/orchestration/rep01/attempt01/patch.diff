@@ -3632,6 +3632,17 @@ class OperationalError(DatabaseError): pass
 class ProgrammingError(DatabaseError): pass
 
 
+class QueryEvent:
+    """Representa um evento de execução de query."""
+    __slots__ = ('sql', 'params', 'duration', 'exception')
+    
+    def __init__(self, sql, params, duration, exception):
+        self.sql = sql
+        self.params = params or ()
+        self.duration = duration
+        self.exception = exception
+
+
 class ExceptionWrapper(object):
     __slots__ = ('exceptions',)
     def __init__(self, exceptions):
@@ -3787,6 +3798,7 @@ class Database(_callable_context_manager):
                            'database driver you are using.')
 
         self.connect_params = {}
+        self.query_hooks = []
         self.init(database, **kwargs)
 
     def init(self, database, **kwargs):
@@ -3892,11 +3904,32 @@ class Database(_callable_context_manager):
 
     def execute_sql(self, sql, params=None):
         self._log_query(sql, params)
-        with __exception_wrapper__:
-            cursor = self.cursor()
-            cursor.execute(sql, params or ())
+        
+        start_time = time.time()
+        exception = None
+        
+        try:
+            with __exception_wrapper__:
+                cursor = self.cursor()
+                cursor.execute(sql, params or ())
+        except Exception as exc:
+            exception = exc
+            raise
+        finally:
+            duration = time.time() - start_time
+            self._call_query_hooks(sql, params, duration, exception)
+            
         return cursor
 
+    def _call_query_hooks(self, sql, params, duration, exception):
+        if not self.query_hooks:
+            return
+            
+        event = QueryEvent(sql, params, duration, exception)
+        for hook in self.query_hooks[:]:  # Cópia para evitar problemas durante a iteração
+            # Chamamos o hook e deixamos qualquer exceção ser propagada
+            hook(event)
+
     def execute(self, query, **context_options):
         ctx = self.get_sql_context(**context_options)
         sql, params = ctx.sql(query).query()
