+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Remove duplicate keys by appending numeric suffixes starting from 2.
+    
+    Each subsequent occurrence gets a suffix _N where N starts at 2 and increases
+    until a unique name is found that doesn't conflict with any existing key
+    or any previously assigned renamed key.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+    
+    # Convert to set for faster lookup of original keys
+    original_keys_set = set(keys)
+    
+    # Track what names we've already used in the result
+    used_names: Set[str] = set()
+    result: List[str] = []
+    
+    for key in keys:
+        if key not in used_names:
+            # First occurrence - keep as is
+            result.append(key)
+            used_names.add(key)
+        else:
+            # Duplicate - need to rename
+            counter = 2
+            new_key = f"{key}_{counter}"
+            # Keep incrementing until we find a name that doesn't conflict
+            # with either original keys or already renamed keys
+            while new_key in original_keys_set or new_key in used_names:
+                counter += 1
+                new_key = f"{key}_{counter}"
+            result.append(new_key)
+            used_names.add(new_key)
+            
+            # Also add to original_keys_set to prevent future conflicts
+            original_keys_set.add(new_key)
+    
+    return result
+
+
