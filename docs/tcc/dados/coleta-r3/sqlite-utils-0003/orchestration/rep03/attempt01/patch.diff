diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..0abf801 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,53 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Normalize a list of column names to avoid duplicates by applying numeric suffixes.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+        
+    :param keys: List of column names that may contain duplicates
+    :return: List of column names with duplicates resolved
+    """
+    if not keys:
+        return keys
+    
+    # Track how many times we've seen each key
+    seen_counts: Dict[str, int] = {}
+    # Track all names that will be in the final result to avoid conflicts
+    used_names: Set[str] = set()
+    result: List[str] = []
+    
+    # First pass: mark all original names as used
+    for key in keys:
+        used_names.add(key)
+    
+    # Second pass: process each key
+    for key in keys:
+        if key not in seen_counts:
+            # First occurrence of this key, keep as-is
+            seen_counts[key] = 1
+            result.append(key)
+        else:
+            # Duplicate key, need to add a suffix
+            i = seen_counts[key] + 1
+            new_name = f"{key}_{i}"
+            # Find the first available suffix that doesn't conflict
+            while new_name in used_names:
+                i += 1
+                new_name = f"{key}_{i}"
+            result.append(new_name)
+            seen_counts[key] = i
+            used_names.add(new_name)
+    
+    return result
