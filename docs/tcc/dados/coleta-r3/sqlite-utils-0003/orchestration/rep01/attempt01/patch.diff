+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Receives a list of column names and returns a new list where repeated names
+    are suffixed with _N to ensure uniqueness, starting from _2 for the first duplicate.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return keys
+    
+    # Count total occurrences of each key
+    total_counts: Dict[str, int] = {}
+    for key in keys:
+        total_counts[key] = total_counts.get(key, 0) + 1
+
+    result: List[str] = []
+    seen_counts: Dict[str, int] = {}
+    
+    for key in keys:
+        total_count = total_counts[key]
+        current_count = seen_counts.get(key, 0)
+        
+        if total_count > 1:
+            # This key appears more than once overall
+            if current_count == 0:
+                # First occurrence - keep as is
+                result.append(key)
+            else:
+                # Subsequent occurrence - add suffix
+                suffix_counter = current_count + 1
+                candidate = f"{key}_{suffix_counter}"
+                # Ensure uniqueness in the final result
+                while candidate in total_counts or candidate in result:
+                    suffix_counter += 1
+                    candidate = f"{key}_{suffix_counter}"
+                result.append(candidate)
+        else:
+            # Unique key - keep as is
+            result.append(key)
+        seen_counts[key] = current_count + 1
+        
+    return result
