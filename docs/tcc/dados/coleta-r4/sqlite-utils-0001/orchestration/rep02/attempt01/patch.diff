+    def _get_destructive_foreign_keys(self):
+        """
+        Retorna uma lista de tuplas (tabela_referenciadora, acao_on_delete) para
+        chaves estrangeiras que possuem ações destrutivas (CASCADE, SET NULL, SET DEFAULT)
+        apontando para esta tabela.
+        """
+        destructive_actions = {"CASCADE", "SET NULL", "SET DEFAULT"}
+        destructive_fks = []
+        
+        # Itera por todas as tabelas do banco para verificar suas chaves estrangeiras
+        for table_info in self.db.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall():
+            referencing_table = table_info[0]
+            # Para cada tabela, obtém a lista de chaves estrangeiras
+            fk_list_query = f"PRAGMA foreign_key_list({referencing_table!r})"
+            for fk_row in self.db.execute(fk_list_query).fetchall():
+                # Colunas da linha de pragma: id, seq, table, from, to, on_update, on_delete, match
+                _, _, referenced_table, _, _, _, on_delete, _ = fk_row
+                if referenced_table == self.name and on_delete.upper() in destructive_actions:
+                    destructive_fks.append((referencing_table, on_delete.upper()))
+                    
+        return destructive_fks
     last_pk: Optional[Any] = None
 
