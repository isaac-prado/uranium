 T = TypeVar("T")
 
 
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list where any duplicates have been renamed
+    with a numeric suffix `_N` starting from 2, ensuring no conflicts with existing names.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+        
+    # Keep track of all original names to avoid conflicts
+    original_names: Set[str] = set(keys)
+    # Keep track of all names we've used so far (including generated ones)
+    used_names: Set[str] = set()
+    result: List[str] = []
+    
+    for key in keys:
+        if key not in used_names:
+            # First occurrence stays as is
+            result.append(key)
+            used_names.add(key)
+        else:
+            # Subsequent occurrences get suffixed
+            # Find the first available suffix that doesn't conflict
+            suffix_counter = 2
+            new_key = f"{key}_{suffix_counter}"
+            while new_key in original_names or new_key in used_names:
+                suffix_counter += 1
+                new_key = f"{key}_{suffix_counter}"
+            result.append(new_key)
+            used_names.add(new_key)
+            
+    return result
+
+
 class _CloseableIterator(Iterator[Row]):
     """Iterator wrapper that closes a file when iteration is complete."""
 
