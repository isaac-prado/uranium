+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve nomes de colunas duplicados adicionando sufixos '_N'.
+    A primeira ocorrência permanece inalterada.
+    
+    Exemplos:
+        dedupe_keys(['id', 'id', 'value', 'value']) 
+        # Retorna: ['id', 'id_2', 'value', 'value_2']
+        
+        dedupe_keys(['id', 'id', 'id_2']) 
+        # Retorna: ['id', 'id_3', 'id_2']
+    """
+    # Conta quantas vezes cada chave aparece
+    key_counts: Dict[str, int] = {}
+    for key in keys:
+        key_counts[key] = key_counts.get(key, 0) + 1
+    
+    # Para chaves que aparecem mais de uma vez, vamos rastrear quantas vezes já usamos cada base
+    used_bases: Dict[str, int] = {}
+    result = []
+    
+    for key in keys:
+        if key_counts[key] > 1:
+            # Esta chave é duplicada, precisamos renomeá-la
+            if key not in used_bases:
+                # Primeira ocorrência - mantém o nome original
+                result.append(key)
+                used_bases[key] = 1
+            else:
+                # Ocorrência repetida - adiciona sufixo
+                used_bases[key] += 1
+                counter = used_bases[key]
+                new_key = f"{key}_{counter}"
+                # Se o novo nome já existe, continua incrementando até encontrar um livre
+                while new_key in key_counts or new_key in used_bases:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result.append(new_key)
+                used_bases[new_key] = 1  # Marca este nome como usado
+        else:
+            # Chave única - mantém o nome original
+            result.append(key)
+            
+    return result
+
