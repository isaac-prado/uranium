+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Renames duplicate keys in a list by appending a numeric suffix (_2, _3, etc.)
+    to ensure all keys are unique, avoiding conflicts with existing keys.
+
+    The first occurrence of a key remains unchanged. Subsequent duplicates are
+    renamed according to the rule: original_key_N, where N starts from 2.
+    If the generated name already exists, N is incremented until a unique name is found.
+
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+
+    Args:
+        keys: A list of strings representing column names.
+
+    Returns:
+        A new list of strings with unique names.
+    """
+    if not keys:
+        return []
+
+    seen_counts: Dict[str, int] = {}
+    new_keys: List[str] = []
+
+    for key in keys:
+        count = seen_counts.get(key, 0)
+        if count == 0:
+            # First time seeing this key, keep it as is.
+            new_keys.append(key)
+        else:
+            # Duplicate found. Generate a new name.
+            new_key = f"{key}_{count + 1}"
+            # If the generated name is already in the final list or will be,
+            # increment the suffix until it's unique.
+            while new_key in new_keys or new_key in keys[len(new_keys):]:
+                count += 1
+                new_key = f"{key}_{count + 1}"
+            new_keys.append(new_key)
+        seen_counts[key] = count + 1
+
+    return new_keys
+
+
 class _CloseableIterator(Iterator[Row]):
     """Iterator wrapper that closes a file when iteration is complete."""
 
