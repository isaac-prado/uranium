+    def _handle_dotted_key(self, key: Key, value: Item) -> "Container":
+        """
+        Handle dotted keys by creating nested table structure.
+        """
+        from .items import Table, Trivia
+        
+        names = tuple(iter(key))
+        name = names[0]
+        name._dotted = True
+        
+        # Create the nested structure from scratch
+        table = Table(Container(True), Trivia(), False, is_super_table=True)
+        # Add the first part of the key directly to avoid recursion
+        if not isinstance(key, Key):
+            key = SingleKey(key)
+        
+        if not isinstance(value, Item):
+            value = _item(value)
+        
+        # Add the first part of the key
+        if name not in self:
+            super(Container, self).__setitem__(str(name), table)
+            self._map[name] = len(self._body)
+            self._body.append((name, table))
+            self._table_keys.append(name)
+        
+        _table = self[name]
+        if not isinstance(_table, Table):
+            raise KeyError(f"Cannot create dotted key '{key}' because '{name}' already exists as a non-table")
+        
+        # Navigate through the nested structure
+        for i, _name in enumerate(names[1:]):
+            if i == len(names) - 2:  # Last part - assign the value
+                _name.sep = key.sep
+                _table.append(_name, value)
+                break
+            else:
+                _name._dotted = True
+                if _name not in _table:
+                    # Create intermediate table
+                    new_table = Table(
+                        Container(True),
+                        Trivia(),
+                        False,
+                        is_super_table=True,
+                    )
+                    _table.append(_name, new_table)
+                _table = _table[_name]
+        
+        return self
+
