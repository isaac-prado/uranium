+    def _parse_dotted_key(self):  # type: () -> Key
+        """
+        Parses a dotted key.
+        """
+        self.mark()
+        keys = []
+        start = self._idx - 1
+        
+        while True:
+            c = self._current
+            
+            if c == '.':
+                # End of current key part
+                part = self._src[start:self._idx - 1].strip()
+                if not part:
+                    raise self.parse_error(EmptyKeyError)
+                keys.append(part)
+                start = self._idx
+                self.inc()
+            elif c in "\"'":
+                # Quoted key part
+                quote_char = c
+                self.inc()
+                part_start = self._idx - 1
+                while self._current != quote_char:
+                    if self.end():
+                        raise self.parse_error(UnexpectedEofError)
+                    self.inc()
+                part = self._src[part_start:self._idx - 1]
+                keys.append('"' + part + '"')
+                self.inc()  # Skip closing quote
+                start = self._idx
+                # Check if we're at the end of the key or expect a dot
+                if self._current == '.':
+                    self.inc()
+                    start = self._idx
+                    continue
+                elif self._current.isspace() or self._current == '=':
+                    break
+            elif c.is_bare_key_char():
+                # Continue bare key part
+                pass
+            elif c.isspace() or c == '=':
+                # End of key
+                part = self._src[start:self._idx - 1].strip()
+                if part:
+                    keys.append(part)
+                break
+            else:
+                raise self.parse_error(UnexpectedCharError, (c,))
+                
+            if not self.inc():
+                # End of input
+                part = self._src[start:self._idx - 1].strip()
+                if part:
+                    keys.append(part)
+                break
+                
+        if not keys:
+            raise self.parse_error(EmptyKeyError)
+            
+        # For dotted keys, we need to return a proper structure
+        # The key should be the first part, and the rest should be handled during assignment
+        key_str = keys[0] if len(keys) == 1 else '.'.join(keys)
+        return Key(key_str, KeyType.Bare, "")
 
