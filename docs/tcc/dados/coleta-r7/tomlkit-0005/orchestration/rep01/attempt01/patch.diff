+    """Wrap a method to always return the parent container's type."""
+
+    def wrapper(self: Any, *args: Any, **kwargs: Any) -> Any:
+        result = method(self, *args, **kwargs)
+        if isinstance(result, list):
+            return self._new(result)
+        elif isinstance(result, dict):
+            return self._new(result)
+        elif isinstance(result, tuple):
+            # For tuples returned by methods like divmod()
+            return tuple(self._new(item) if isinstance(item, (list, dict)) else item for item in result)
+        return result
+    return wrapper
