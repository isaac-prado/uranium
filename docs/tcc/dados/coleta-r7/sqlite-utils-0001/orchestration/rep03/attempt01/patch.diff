+    def _check_destructive_foreign_keys(self) -> None:
+        """
+        Check if there are destructive foreign key references pointing to this table
+        within an active transaction with foreign keys enabled.
+        Raises TransactionError if destructive references are found.
+        """
+        # Check if we're in a transaction
+        if not self.db.is_in_transaction():
+            return
+            
+        # Check if foreign keys are enabled
+        fk_enabled = self.db.execute("PRAGMA foreign_keys").fetchone()[0]
+        if not fk_enabled:
+            return
+            
+        # Get all foreign key references to this table with destructive actions
+        # We need to check all tables to find ones that reference this table
+        cursor = self.db.execute("""
+            SELECT 
+                m.name as referencing_table,
+                fk."on_delete" as on_delete_action
+            FROM 
+                sqlite_master AS m
+                JOIN pragma_foreign_key_list(m.name) AS fk 
+            WHERE 
+                fk."table" = ?
+                AND fk."on_delete" IN ('CASCADE', 'SET NULL', 'SET DEFAULT')
+        """, (self.name,))
+        
+        destructive_refs = cursor.fetchall()
+        
+        if destructive_refs:
+            ref_info = []
+            for ref in destructive_refs:
+                ref_info.append(f"{ref[0]} (ON DELETE {ref[1]})")
+            refs_str = ", ".join(ref_info)
+            raise TransactionError(
+                f"Cannot transform table '{self.name}' within a transaction with "
+                f"foreign_keys=ON when it is referenced by tables with destructive "
+                f"foreign key actions: {refs_str}"
+            )
