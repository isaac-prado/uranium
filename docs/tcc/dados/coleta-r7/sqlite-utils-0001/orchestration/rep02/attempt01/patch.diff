+    def _get_destructive_foreign_keys(self):
+        """
+        Identifica chaves estrangeiras destrutivas que apontam para esta tabela.
+        Retorna uma lista de tuplas (tabela_referenciadora, acao_on_delete, coluna).
+        """
+        destructive_actions = {'CASCADE', 'SET NULL', 'SET DEFAULT'}
+        destructive_fks = []
+        
+        # Iterar por todas as tabelas do banco
+        cursor = self.db.execute("SELECT name FROM sqlite_master WHERE type='table'")
+        tables = cursor.fetchall()
+        
+        for (referencing_table,) in tables:
+            # Para cada tabela, verificar suas chaves estrangeiras
+            fk_cursor = self.db.execute(f"PRAGMA foreign_key_list({referencing_table})")
+            for fk_row in fk_cursor.fetchall():
+                # id, seq, table_name, from_, to_, on_update, on_delete, match
+                _, _, referenced_table, from_col, to_col, _, on_delete, _ = fk_row
+                if (referenced_table == self.name and 
+                    on_delete.upper() in destructive_actions):
+                    destructive_fks.append((referencing_table, on_delete.upper(), from_col))
+                    
+        return destructive_fks
+
     def __repr__(self) -> str:
         return "<Table {}{}>".format(
             self.name,
