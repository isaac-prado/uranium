+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate column names by appending a suffix '_N' to the duplicates,
+    starting from '_2'. The renaming respects already existing suffixed names.
+
+    Examples:
+    [] -> []
+    ["id", "name"] -> ["id", "name"]
+    ["id", "id"] -> ["id", "id_2"]
+    ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+    ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+    ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+    ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+
+    # We'll build a map of original key to its count of occurrences so far
+    counts: Dict[str, int] = {}
+    # And a set of all current keys to avoid conflicts
+    seen: Set[str] = set(keys)
+    result: List[str] = []
+
+    for key in keys:
+        if key not in counts:
+            # First occurrence, keep as is
+            counts[key] = 1
+            result.append(key)
+        else:
+            # Duplicate found
+            counts[key] += 1
+            new_key = f"{key}_{counts[key]}"
+            # If the new_key already exists (e.g., due to a real column named 'id_2'),
+            # we need to find the next available number.
+            counter = counts[key]
+            while new_key in seen:
+                counter += 1
+                new_key = f"{key}_{counter}"
+            # Add the resolved key to our structures
+            seen.add(new_key)
+            # Update the count for this base key to the highest suffix used
+            counts[key] = counter
+            result.append(new_key)
+
+    return result
+
+
 class _CloseableIterator(Iterator[Row]):
     """Iterator wrapper that closes a file when iteration is complete."""
 
