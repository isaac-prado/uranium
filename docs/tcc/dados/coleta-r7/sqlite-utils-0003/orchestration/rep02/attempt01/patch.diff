+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate column names by applying numeric suffixes (_2, _3, etc.)
+    to ensure all names are unique while preserving order.
+
+    The first occurrence of a name remains unchanged. Subsequent duplicates
+    are suffixed with the lowest integer that makes them unique.
+
+    Example:
+        >>> dedupe_keys(["id", "name", "id", "id"])
+        ["id", "name", "id_2", "id_3"]
+
+    :param keys: A list of column names, potentially with duplicates.
+    :return: A list of unique column names derived from the input.
+    """
+    if not keys:
+        return []
+
+    # Track the set of names already used to avoid conflicts
+    used_names: Set[str] = set()
+    result: List[str] = []
+
+    for key in keys:
+        # If the key is already unique, use it directly
+        if key not in used_names:
+            result.append(key)
+            used_names.add(key)
+        else:
+            # Start checking for the next available suffix
+            suffix = 2
+            new_key = f"{key}_{suffix}"
+            # Keep incrementing until we find a unique name
+            while new_key in used_names:
+                suffix += 1
+                new_key = f"{key}_{suffix}"
+            
+            result.append(new_key)
+            used_names.add(new_key)
+            
+    return result
+
+
