+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate keys by appending _2, _3, etc. to duplicates,
+    avoiding conflicts with existing keys.
+
+    Examples:
+    >>> dedupe_keys([])
+    []
+    >>> dedupe_keys(["id", "name"])
+    ['id', 'name']
+    >>> dedupe_keys(["id", "id"])
+    ['id', 'id_2']
+    >>> dedupe_keys(["id", "id", "id"])
+    ['id', 'id_2', 'id_3']
+    >>> dedupe_keys(["id", "id", "id_2"])
+    ['id', 'id_3', 'id_2']
+    >>> dedupe_keys(["id_2", "id", "id"])
+    ['id_2', 'id', 'id_3']
+    >>> dedupe_keys(["id", "id", "id_2", "id_2"])
+    ['id', 'id_3', 'id_2', 'id_2_2']
+    """
+    if not keys:
+        return keys
+    
+    # Pre-count all keys to identify duplicates
+    counts: Dict[str, int] = {}
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+        
+    # Track keys we've already used in the output to prevent conflicts
+    used: Set[str] = set()
+    result: List[str] = []
+    
+    # Process each key in order
+    for key in keys:
+        if counts[key] == 1:
+            # Unique key - add directly
+            result.append(key)
+            used.add(key)
+        else:
+            # Duplicate key - handle specially
+            if key not in used:
+                # First occurrence of a duplicate key - add as-is
+                result.append(key)
+                used.add(key)
+            else:
+                # Subsequent occurrence - find a unique suffix
+                counter = 2
+                while True:
+                    candidate = f"{key}_{counter}"
+                    # Ensure the candidate doesn't conflict with:
+                    # 1. Any original key name
+                    # 2. Any key we've already added to the result
+                    if candidate not in counts and candidate not in used:
+                        result.append(candidate)
+                        used.add(candidate)
+                        break
+                    counter += 1
+                    
+    return result
+
