diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..4ac467f 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,48 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Deduplicate a list of column names by appending numeric suffixes to duplicates.
+
+    The first occurrence of a column name is kept as-is. Each subsequent occurrence
+    receives a suffix `_N` where `N` starts at 2 and increments until the name does not
+    collide with any other name in the list (original or already renamed).
+
+    Example usage::
+
+        from sqlite_utils.utils import dedupe_keys
+
+        dedupe_keys(["id", "name"])
+        # Outputs ["id", "name"]
+
+        dedupe_keys(["id", "id"])
+        # Outputs ["id", "id_2"]
+
+        dedupe_keys(["id", "id", "id_2"])
+        # Outputs ["id", "id_3", "id_2"]
+
+    :param keys: List of column names, possibly with duplicates
+    :return: List of unique column names, in the same order as the input
+    """
+    # Collect all original keys to check for collisions
+    original_keys = set(keys)
+    result = []
+    used = set()
+    for key in keys:
+        if key not in used:
+            result.append(key)
+            used.add(key)
+        else:
+            # Find the smallest N >= 2 such that key_N is not in original_keys or used
+            n = 2
+            while True:
+                new_key = f"{key}_{n}"
+                if new_key not in original_keys and new_key not in used:
+                    break
+                n += 1
+            result.append(new_key)
+            used.add(new_key)
+    return result
