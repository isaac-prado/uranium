diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..260bab2 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,42 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Deduplicate a list of column names by appending numeric suffixes to duplicates.
+    
+    The first occurrence of each name is preserved. Subsequent occurrences are
+    renamed with a suffix `_N` (starting at 2), ensuring the new name does not
+    collide with any existing name (original or already renamed).
+    
+    Example usage::
+
+        from sqlite_utils.utils import dedupe_keys
+
+        dedupe_keys(["id", "id", "id_2"])
+        # Returns ["id", "id_3", "id_2"]
+
+    :param keys: List of column names, possibly with duplicates
+    :return: New list with duplicates renamed, preserving order and size
+    """
+    result = []
+    used = set()
+    # First, collect all original keys to check for collisions
+    all_original_keys = set(keys)
+    for key in keys:
+        if key not in used:
+            result.append(key)
+            used.add(key)
+        else:
+            # Find the smallest suffix that doesn't collide with any original or used key
+            suffix = 2
+            while True:
+                new_key = f"{key}_{suffix}"
+                if new_key not in used and new_key not in all_original_keys:
+                    break
+                suffix += 1
+            result.append(new_key)
+            used.add(new_key)
+    return result
