diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..d3b1a7c 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,51 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Deduplicate a list of column names by appending numeric suffixes to duplicates.
+
+    The first occurrence of a name is preserved. Subsequent occurrences are
+    renamed with suffixes `_2`, `_3`, etc., ensuring the new name does not
+    collide with any other name in the list (original or already renamed).
+
+    Example usage::
+
+        from sqlite_utils.utils import dedupe_keys
+
+        dedupe_keys(["id", "name"])
+        # Returns ["id", "name"]
+
+        dedupe_keys(["id", "id"])
+        # Returns ["id", "id_2"]
+
+        dedupe_keys(["id", "id", "id_2"])
+        # Returns ["id", "id_3", "id_2"]
+
+    :param keys: List of column names, possibly with duplicates
+    :return: New list with unique names, preserving order
+    """
+    # First, collect all keys that appear in the original list
+    # to check for collisions with existing names
+    original_keys = set(keys)
+    
+    result = []
+    used = set()
+    for key in keys:
+        if key not in used:
+            result.append(key)
+            used.add(key)
+        else:
+            # Find the smallest suffix that doesn't collide with any key
+            # (original or already renamed)
+            suffix = 2
+            while True:
+                new_key = f"{key}_{suffix}"
+                if new_key not in used and new_key not in original_keys:
+                    break
+                suffix += 1
+            result.append(new_key)
+            used.add(new_key)
+    return result
