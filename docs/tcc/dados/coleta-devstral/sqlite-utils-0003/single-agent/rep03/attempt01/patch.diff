diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
index 865ee79..f6c48aa 100644
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -629,3 +629,54 @@ def flatten(row: Dict[str, Any]) -> Dict[str, Any]:
     :param row: A Python dictionary, optionally with nested dictionaries
     """
     return dict(_flatten(row))
+
+
+def dedupe_keys(column_names: List[str]) -> List[str]:
+    """
+    Takes a list of column names and returns a new list with duplicate names
+    resolved by appending numeric suffixes _N starting from 2.
+    
+    The first occurrence of a name is kept as-is. Each subsequent occurrence
+    gets a suffix _N where N starts at 2 and increments until a non-colliding
+    name is found, considering both original names and already assigned suffixes.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    
+    :param column_names: List of column names, possibly with duplicates
+    :returns: New list with duplicates resolved
+    """
+    if not column_names:
+        return []
+    
+    # First, count occurrences of each name to know which ones need suffixes
+    name_counts = {}
+    for name in column_names:
+        name_counts[name] = name_counts.get(name, 0) + 1
+    
+    # Track which names are already taken (including original names and generated ones)
+    used_names = set()
+    result = []
+    
+    for name in column_names:
+        if name not in used_names:
+            result.append(name)
+            used_names.add(name)
+        else:
+            # Find the next available suffix
+            n = 2
+            while True:
+                new_name = f"{name}_{n}"
+                if new_name not in used_names and new_name not in name_counts:
+                    result.append(new_name)
+                    used_names.add(new_name)
+                    break
+                n += 1
+    
+    return result
