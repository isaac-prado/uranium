+def dedupe_keys(column_names: List[str]) -> List[str]:
+    """
+    Deduplicate column names by appending numeric suffixes to duplicates.
+    
+    The first occurrence of a name is kept as-is. Each subsequent duplicate
+    gets a suffix _N where N starts at 2 and increments until a non-colliding
+    name is found. The order of columns is preserved.
+    
+    Examples:
+        >>> dedupe_keys([])
+        []
+        >>> dedupe_keys(["id", "name"])
+        ["id", "name"]
+        >>> dedupe_keys(["id", "id"])
+        ["id", "id_2"]
+        >>> dedupe_keys(["id", "id", "id"])
+        ["id", "id_2", "id_3"]
+        >>> dedupe_keys(["id", "id", "id_2"])
+        ["id", "id_3", "id_2"]
+        >>> dedupe_keys(["id_2", "id", "id"])
+        ["id_2", "id", "id_3"]
+        >>> dedupe_keys(["id", "id", "id_2", "id_2"])
+        ["id", "id_3", "id_2", "id_2_2"]
+    
+    :param column_names: List of column names, possibly with duplicates
+    :returns: New list with duplicates renamed to avoid collisions
+    """
+    # First, count occurrences of each name to know which ones are duplicates
+    name_counts = {}
+    for name in column_names:
+        name_counts[name] = name_counts.get(name, 0) + 1
+    
+    # Also collect all names that exist in the original list
+    all_original_names = set(column_names)
+    
+    result = []
+    used_names = set()
+    
+    for name in column_names:
+        if name not in used_names:
+            # Name is available, use it as-is
+            result.append(name)
+            used_names.add(name)
+        else:
+            # Name is a duplicate, find a suffix that doesn't collide
+            # with ANY name in used_names OR in all_original_names
+            suffix = 2
+            while True:
+                new_name = f"{name}_{suffix}"
+                if new_name not in used_names and new_name not in all_original_names:
+                    result.append(new_name)
+                    used_names.add(new_name)
+                    break
+                suffix += 1
+    
+    return result
+
+
