+    def _append_dotted_key(self, container, key, value):  # type: (Container, Key, Item) -> None
+        """
+        Appends a dotted key to the container, creating nested tables as needed.
+        """
+        # Split the key into parts, handling quoted parts correctly
+        parts = []
+        current_part = ""
+        in_quotes = False
+        quote_char = None
+        
+        for c in key.key:
+            if c in ('"', "'") and (not in_quotes or c == quote_char):
+                if in_quotes:
+                    # End of quoted part
+                    in_quotes = False
+                    quote_char = None
+                    current_part += c
+                    parts.append(current_part)
+                    current_part = ""
+                else:
+                    # Start of quoted part
+                    in_quotes = True
+                    quote_char = c
+                    current_part += c
+            elif c == "." and not in_quotes:
+                if current_part:
+                    parts.append(current_part)
+                    current_part = ""
+            else:
+                current_part += c
+        
+        if current_part:
+            parts.append(current_part)
+        
+        # Convert parts to Keys
+        key_parts = []
+        for part in parts:
+            if part.startswith('"') and part.endswith('"'):
+                key_parts.append(Key(part[1:-1], KeyType.Basic, ""))
+            elif part.startswith("'") and part.endswith("'"):
+                key_parts.append(Key(part[1:-1], KeyType.Literal, ""))
+            else:
+                key_parts.append(Key(part, KeyType.Bare, ""))
+        
+        current_container = container
+        
+        for i, part in enumerate(key_parts[:-1]):
+            if part not in current_container:
+                # Create a new table for this part
+                table = Table(Container(), Trivia(), False, name=part.key)
+                current_container.append(part, table)
+            
+            # Move into the nested table
+            table_item = current_container._body[current_container._map[part]][1]
+            current_container = table_item.value
+        
+        # Add the value to the final part
+        current_container.append(key_parts[-1], value)
