+    def _add_dotted_key(self, body, key, value):  # type: (Container, Key, Item) -> None
+        """
+        Adds a dotted key to the document, creating nested tables as needed.
+        """
+        # Split the dotted key into parts
+        parts = list(self._split_table_name(key.key))
+        
+        # Start from the root body
+        current_container = body
+        
+        # Navigate through the parts, creating tables as needed
+        for i, part in enumerate(parts[:-1]):
+            # Check if this part already exists in the current container
+            if part in current_container:
+                item = current_container[part]
+                if isinstance(item, Table):
+                    current_container = item.value
+                else:
+                    # This should not happen in valid TOML, but let's handle it
+                    # by replacing the existing item with a table
+                    table = Table(Container(), Trivia(), False, is_super_table=(i < len(parts) - 2), name=part.key)
+                    current_container._replace(part, part, table)
+                    current_container = table.value
+            else:
+                # Create a new table for this part
+                is_super = i < len(parts) - 2
+                table = Table(Container(), Trivia(), False, is_super_table=is_super, name=part.key)
+                current_container.append(part, table)
+                current_container = table.value
+        
+        # Add the final part with the value
+        final_part = parts[-1]
+        current_container.append(final_part, value)
+
