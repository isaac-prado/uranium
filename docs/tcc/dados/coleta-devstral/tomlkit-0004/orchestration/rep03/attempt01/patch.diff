+    def _handle_dotted_key(self, body, key, value):
+        """
+        Handles a dotted key by splitting it into parts and creating nested tables.
+        """
+        # Split the dotted key into parts
+        parts = list(self._split_table_name(key.key))
+        
+        # Navigate through the parts to find or create the nested tables
+        current_container = body
+        for part in parts[:-1]:
+            # Check if the part already exists in the current container
+            if part.key in current_container:
+                item = current_container[part.key]
+                if isinstance(item, Table):
+                    current_container = item.value
+                else:
+                    # The key exists but is not a table, so we need to replace it with a table
+                    # This is a bit tricky, but we'll create a new table and move the existing item into it
+                    new_table = Table(Container(), Trivia(), False, False)
+                    new_table.value.append(part, item)
+                    current_container._body[current_container._map[part]] = (part, new_table)
+                    current_container[part.key] = new_table.value
+                    current_container = new_table.value
+            else:
+                # Create a new table for this part
+                new_table = Table(Container(), Trivia(), False, False)
+                new_table.name = part.key
+                current_container.append(part, new_table)
+                current_container = new_table.value
+        
+        # Add the final part and value to the current container
+        current_container.append(parts[-1], value)
+
