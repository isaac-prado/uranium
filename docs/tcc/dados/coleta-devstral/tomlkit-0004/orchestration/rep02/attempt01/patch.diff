+    def _split_key(self, key):  # type: (str) -> Generator[Key]
+        """
+        Splits a dotted key into its constituent parts.
+        """
+        in_quoted = False
+        quote_char = None
+        current = ""
+        t = KeyType.Bare
+        for c in key:
+            c = TOMLChar(c)
+
+            if c == "." and not in_quoted:
+                if not current:
+                    raise self.parse_error()
+
+                yield Key(current, t=t, sep="")
+                current = ""
+                t = KeyType.Bare
+                continue
+            elif c in {"'", '"'}:
+                if in_quoted:
+                    if c == quote_char:
+                        in_quoted = False
+                        # Do not include the closing quote in the key
+                        continue
+                    else:
+                        current += c
+                        continue
+                else:
+                    in_quoted = True
+                    quote_char = c
+                    t = KeyType.Literal if c == "'" else KeyType.Basic
+                    # Do not include the opening quote in the key
+                    continue
+            elif in_quoted or c.is_bare_key_char():
+                current += c
+            else:
+                raise self.parse_error()
+
+        if current:
+            yield Key(current, t=t, sep="")
+
+    def _add_dotted_key(self, container, key, value):  # type: (Container, Key, Item) -> None
+        """
+        Adds a dotted key to the container, creating nested tables as needed.
+        """
+        parts = list(self._split_key(key.key))
+        if not parts:
+            return
+        
+        # Navigate through the parts to find the correct container
+        current_container = container
+        for i, part in enumerate(parts[:-1]):
+            if part in current_container:
+                current_item = current_container[part]
+                if isinstance(current_item, Table):
+                    current_container = current_item.value
+                else:
+                    # Replace the existing item with a table
+                    current_table = Table(Container(), Trivia(), False, name=part.key)
+                    current_container._body[current_container._map[part]] = (part, current_table)
+                    current_container = current_table.value
+            else:
+                # Create a new table
+                current_table = Table(Container(), Trivia(), False, name=part.key)
+                current_container.append(part, current_table)
+                current_container = current_table.value
+        
+        # Add the final part and value
+        last_part = parts[-1]
+        current_container.append(last_part, value)
+
+
