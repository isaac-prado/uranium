+    def foreign_keys_with_destructive_actions(self, table_name: str) -> List[Tuple[str, str]]:
+        """
+        Return a list of (referencing_table, on_delete_action) tuples for all
+        foreign keys that reference the given table with destructive actions
+        (CASCADE, SET NULL, SET DEFAULT). Includes self-references.
+        """
+        destructive_actions = {"CASCADE", "SET NULL", "SET DEFAULT"}
+        result = []
+        for other_table_name in self.table_names():
+            other_table = self.table(other_table_name)
+            for fk in other_table.foreign_keys:
+                if fk.other_table == table_name and fk.on_delete in destructive_actions:
+                    result.append((other_table_name, fk.on_delete.upper()))
+        return result
+
     @property
     def tables(self) -> List["Table"]:
         "List of Table objects in this database."
