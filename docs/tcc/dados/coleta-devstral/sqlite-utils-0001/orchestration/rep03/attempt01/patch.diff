+    def get_destructive_foreign_key_references(self, table_name: str) -> List[Tuple[str, str]]:
+        """
+        Return a list of (referencing_table, on_delete_action) tuples for tables
+        that reference the given table with a destructive ON DELETE action
+        (CASCADE, SET NULL, or SET DEFAULT).
+        """
+        destructive_actions = {"CASCADE", "SET NULL", "SET DEFAULT"}
+        references = []
+        for table in self.tables:
+            for fk in table.foreign_keys:
+                if fk.other_table == table_name and fk.on_delete.upper() in destructive_actions:
+                    references.append((fk.table, fk.on_delete.upper()))
+        return references
+
