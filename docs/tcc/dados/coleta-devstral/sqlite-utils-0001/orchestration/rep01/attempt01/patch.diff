+    def _get_destructive_foreign_key_references(self) -> List[Tuple[str, str]]:
+        """
+        Return a list of (table_name, on_delete_action) tuples for tables that
+        reference this table with destructive ON DELETE actions (CASCADE, SET NULL, SET DEFAULT).
+        Includes self-references.
+        """
+        destructive_actions = {"CASCADE", "SET NULL", "SET DEFAULT"}
+        references = []
+        
+        for table in self.db.tables:
+            for fk in table.foreign_keys:
+                if fk.other_table == self.name:
+                    on_delete = fk.on_delete.upper() if fk.on_delete else "NO ACTION"
+                    if on_delete in destructive_actions:
+                        references.append((table.name, on_delete))
+        
+        return references
+
     @property
     def virtual_table_using(self) -> Optional[str]:
         "Type of virtual table, or ``None`` if this is not a virtual table."
@@ -2542,6 +2560,25 @@ class Table(Queryable):
         """
         if not self.exists():
             raise ValueError("Cannot transform a table that doesn't exist yet")
+        
+        # Check for destructive foreign key references in transaction
+        already_in_transaction = self.db.conn.in_transaction
+        pragma_foreign_keys_was_on = bool(
+            self.db.execute("PRAGMA foreign_keys").fetchone()[0]
+        )
+        
+        if already_in_transaction and pragma_foreign_keys_was_on:
+            destructive_refs = self._get_destructive_foreign_key_references()
+            if destructive_refs:
+                refs_str = ", ".join(
+                    f"{table} (ON DELETE {action})" 
+                    for table, action in destructive_refs
+                )
