+    def _get_destructive_foreign_key_references(self) -> List[Dict[str, str]]:
+        """
+        Return a list of tables that reference this table with destructive ON DELETE actions.
+        Each entry is a dict with 'table' and 'on_delete' keys.
+        Destructive actions are: CASCADE, SET NULL, SET DEFAULT.
+        If a table has multiple foreign keys to this table, include all unique destructive actions
+        in a single entry with actions separated by '/'.
+        """
+        destructive_actions = {"CASCADE", "SET NULL", "SET DEFAULT"}
+        references = []
+        
+        for table in self.db.tables:
+            table_destructive_actions = set()
+            for fk in table.foreign_keys:
+                # Check if this foreign key references our table
+                if fk.other_table == self.name:
+                    # Normalize the on_delete action to uppercase
+                    on_delete_upper = fk.on_delete.upper()
+                    # Check if it's a destructive action
+                    if on_delete_upper in destructive_actions:
+                        table_destructive_actions.add(on_delete_upper)
+            
+            # If this table has any destructive actions, add it to references
+            if table_destructive_actions:
+                # Sort actions for consistent ordering
+                sorted_actions = sorted(table_destructive_actions)
+                # Join multiple actions with '/'
+                actions_str = "/".join(sorted_actions)
+                references.append({
+                    'table': table.name,
+                    'on_delete': actions_str
+                })
+        
+        return references
+
     def transform(
         self,
         *,
@@ -2560,6 +2595,20 @@ class Table(Queryable):
             self.db.execute("PRAGMA foreign_keys").fetchone()[0]
         )
         already_in_transaction = self.db.conn.in_transaction
+        
+        # Check for destructive foreign key references when in transaction
+        if pragma_foreign_keys_was_on and already_in_transaction:
+            destructive_references = self._get_destructive_foreign_key_references()
+            if destructive_references:
+                table_name = self.name
+                refs_text = ", ".join(
+                    f"{ref['table']} ({ref['on_delete']})" 
+                    for ref in destructive_references
+                )
+                raise TransactionError(
+                    f"Cannot alter table '{table_name}' while in transaction: "
+                    f"it is referenced by {refs_text} with destructive ON DELETE actions"
+                )
         should_disable_foreign_keys = (
             pragma_foreign_keys_was_on and not already_in_transaction
         )
