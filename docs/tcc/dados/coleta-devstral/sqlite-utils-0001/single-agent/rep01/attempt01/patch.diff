diff --git a/sqlite_utils/db.py b/sqlite_utils/db.py
index d709fb9..5683b61 100644
--- a/sqlite_utils/db.py
+++ b/sqlite_utils/db.py
@@ -2310,6 +2310,21 @@ class Table(Queryable):
             )
         return fks
 
+    def foreign_keys_referencing(self) -> List["ForeignKey"]:
+        """
+        List of foreign keys in other tables that reference this table.
+
+        Returns foreign keys from other tables that have this table as their
+        ``other_table``, meaning they reference this table. This includes
+        foreign keys defined in the same table (self-references).
+        """
+        referencing_fks = []
+        for other_table in self.db.tables:
+            for fk in other_table.foreign_keys:
+                if fk.other_table == self.name:
+                    referencing_fks.append(fk)
+        return referencing_fks
+
     @property
     def virtual_table_using(self) -> Optional[str]:
         "Type of virtual table, or ``None`` if this is not a virtual table."
@@ -2560,6 +2575,26 @@ class Table(Queryable):
             self.db.execute("PRAGMA foreign_keys").fetchone()[0]
         )
         already_in_transaction = self.db.conn.in_transaction
+        
+        # Check for destructive foreign key references if in transaction
+        if already_in_transaction and pragma_foreign_keys_was_on:
+            destructive_fks = []
+            for fk in self.foreign_keys_referencing():
+                on_delete = fk.on_delete.upper() if fk.on_delete else "NO ACTION"
+                if on_delete in ("CASCADE", "SET NULL", "SET DEFAULT"):
+                    destructive_fks.append((fk.table, on_delete))
+            if destructive_fks:
+                # Format error message
+                table_names = [fk[0] for fk in destructive_fks]
+                actions = [fk[1] for fk in destructive_fks]
+                references = ", ".join(
+                    f"{table} ({action})" for table, action in zip(table_names, actions)
+                )
+                raise TransactionError(
+                    f"Cannot alter table '{self.name}' inside a transaction: "
+                    f"it is referenced by {references}"
+                )
+        
         should_disable_foreign_keys = (
             pragma_foreign_keys_was_on and not already_in_transaction
         )
