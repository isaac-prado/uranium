+    def _handle_dotted_key(self, key: DottedKey, item: Item) -> "Container":
+        names = tuple(iter(key))
+        name = names[0]
+        name._dotted = True
+        if name in self:
+            if not isinstance(self[name], Table):
+                # Create a super table to hold the nested structure
+                table = Table(Container(True), Trivia(), False, is_super_table=True)
+                _table = table
+                for i, _name in enumerate(names[1:]):
+                    if i == len(names) - 2:
+                        _name.sep = key.sep
+                        _table.append(_name, item)
+                    else:
+                        _name._dotted = True
+                        _table.append(
+                            _name,
+                            Table(
+                                Container(True),
+                                Trivia(),
+                                False,
+                                is_super_table=i < len(names) - 2,
+                            ),
+                        )
+                        _table = _table[_name]
+                item = table
+            else:
+                # The first part of the key already exists as a table
+                # We need to add the remaining parts to it
+                _table = self[name]
+                for i, _name in enumerate(names[1:]):
+                    if i == len(names) - 2:
+                        _name.sep = key.sep
+                        _table.append(_name, item)
+                    else:
+                        _name._dotted = True
+                        if _name not in _table:
+                            _table.append(
+                                _name,
+                                Table(
+                                    Container(True),
+                                    Trivia(),
+                                    False,
+                                    is_super_table=i < len(names) - 2,
+                                ),
+                            )
+                        _table = _table[_name]
+            self.append(name, item)
+        else:
+            # Create a new super table for the dotted key
+            table = Table(Container(True), Trivia(), False, is_super_table=True)
+            _table = table
+            for i, _name in enumerate(names[1:]):
+                if i == len(names) - 2:
+                    _name.sep = key.sep
+                    _table.append(_name, item)
+                else:
+                    _name._dotted = True
+                    _table.append(
+                        _name,
+                        Table(
+                            Container(True),
+                            Trivia(),
+                            False,
+                            is_super_table=i < len(names) - 2,
+                        ),
+                    )
+                    _table = _table[_name]
+            self.append(name, table)
+
+        return self
+
     def __len__(self) -> int:
