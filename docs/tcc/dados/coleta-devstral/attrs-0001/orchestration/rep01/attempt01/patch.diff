diff --git a/src/attr/_funcs.py b/src/attr/_funcs.py
index 518be16..13a9d68 100644
--- a/src/attr/_funcs.py
+++ b/src/attr/_funcs.py
@@ -296,6 +296,16 @@ def has(cls):
 
     :rtype: bool
     """
+    # Handle generic specialized classes (e.g., Caixa[str])
+    # by checking the origin class if cls is a generic alias.
+    if not isinstance(cls, type):
+        try:
+            import typing
+            cls = typing.get_origin(cls)
+        except (AttributeError, TypeError):
+            # If get_origin fails, cls is not a generic alias.
+            return False
+    
     return getattr(cls, "__attrs_attrs__", None) is not None
 
 
