         if not isinstance(item, Item):
             item = _item(item)
 
+        # Handle dotted keys by creating nested tables
+        if key is not None and key.is_dotted():
+            from .items import Table
+            names = tuple(iter(key))
+            name = names[0]
+            name._dotted = True
+            
+            # Create the nested structure directly
+            if not isinstance(item, Table):
+                table = Table(Container(True), item.trivia, False, is_super_table=True)
+                _table = table
+                for i, _name in enumerate(names[1:]):
+                    if i == len(names) - 2:
+                        _name.sep = key.sep
+                        _table.append(_name, item)
+                    else:
+                        _name._dotted = True
+                        new_table = Table(
+                            Container(True),
+                            item.trivia,
+                            False,
+                            is_super_table=i < len(names) - 2,
+                        )
+                        _table.append(_name, new_table)
+                        _table = _table[_name]
+
+                # Add the top-level key with the nested table structure
+                # Bypass normal append logic to avoid recursion
+                top_key = name
+                top_item = table
+                
+                if isinstance(top_item, (AoT, Table)) and top_item.name is None:
+                    top_item.name = top_key.key
+
+                # Directly add to body and map without going through full append logic
+                if top_key in self._map:
+                    raise KeyAlreadyPresent(top_key)
+                
+                self._map[top_key] = len(self._body)
+                self._body.append((top_key, top_item))
+                if top_item.is_table():
+                    self._table_keys.append(top_key)
+
+                if top_key is not None:
+                    dict.__setitem__(self, top_key.key, top_item.value)
+
+                return self
