+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list where any duplicates
+    have been renamed with a numeric suffix `_N`, starting from 2.
+    
+    The renaming ensures that no generated name conflicts with any original
+    or already-renamed name in the list.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+        
+    # Count occurrences of each key to identify duplicates
+    counts: Dict[str, int] = {}
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+    
+    # If no duplicates, return original list
+    if all(count == 1 for count in counts.values()):
+        return keys[:]
+    
+    # Set of all original keys to avoid conflicts
+    all_original_keys = set(keys)
+    result: List[str] = []
+    seen_counts: Dict[str, int] = {}
+    
+    for key in keys:
+        if counts[key] == 1:
+            # Unique key, no change needed
+            result.append(key)
+        else:
+            # Duplicate key, need to rename
+            seen_count = seen_counts.get(key, 0) + 1
+            seen_counts[key] = seen_count
+            
+            if seen_count == 1:
+                # First occurrence stays as is
+                result.append(key)
+            else:
+                # Subsequent occurrences get a suffix
+                new_key = f"{key}_{seen_count}"
+                # Ensure the new key doesn't conflict with existing ones
+                counter = seen_count
+                while new_key in all_original_keys or new_key in result:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result.append(new_key)
+                
+    return result
+
