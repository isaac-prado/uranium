diff --git a/sqlite_utils/db.py b/sqlite_utils/db.py
index d709fb9..4da19e2 100644
--- a/sqlite_utils/db.py
+++ b/sqlite_utils/db.py
@@ -2560,6 +2560,30 @@ class Table(Queryable):
             self.db.execute("PRAGMA foreign_keys").fetchone()[0]
         )
         already_in_transaction = self.db.conn.in_transaction
+        
+        # Check for destructive foreign key references during active transactions
+        if pragma_foreign_keys_was_on and already_in_transaction:
+            # Find tables that reference this table with destructive actions
+            destructive_refs = []
+            for table_obj in self.db.tables:
+                for fk in table_obj.foreign_keys:
+                    if fk.other_table == self.name:
+                        # Check if the action is destructive (CASCADE, SET NULL, SET DEFAULT)
+                        on_delete_action = fk.on_delete.upper() if fk.on_delete else ""
+                        if on_delete_action in ("CASCADE", "SET NULL", "SET DEFAULT"):
+                            destructive_refs.append((table_obj.name, on_delete_action))
+            
+            if destructive_refs:
+                # Build error message with details
+                ref_details = ", ".join(
+                    f"{table} ON DELETE {action}" 
+                    for table, action in destructive_refs
+                )
+                raise TransactionError(
+                    f"Cannot transform table '{self.name}' with destructive foreign key "
+                    f"references from: {ref_details}"
+                )
+        
         should_disable_foreign_keys = (
             pragma_foreign_keys_was_on and not already_in_transaction
         )
