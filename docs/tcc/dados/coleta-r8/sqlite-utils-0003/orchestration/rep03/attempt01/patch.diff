+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Renames duplicate keys in a list by appending a numeric suffix (_2, _3, etc.)
+    to ensure all keys are unique, preserving the original order.
+
+    The first occurrence of a key remains unchanged. Subsequent duplicates are
+    renamed. If a potential new key (e.g., 'key_2') already exists, the suffix
+    is incremented until a unique name is found.
+
+    Examples:
+        [] -> []
+        ['id', 'name'] -> ['id', 'name']
+        ['id', 'id'] -> ['id', 'id_2']
+        ['id', 'id', 'id'] -> ['id', 'id_2', 'id_3']
+        ['id', 'id', 'id_2'] -> ['id', 'id_3', 'id_2']
+        ['id_2', 'id', 'id'] -> ['id_2', 'id', 'id_3']
+        ['id', 'id', 'id_2', 'id_2'] -> ['id', 'id_3', 'id_2', 'id_2_2']
+
+    Args:
+        keys: A list of strings representing column names.
+
+    Returns:
+        A new list of strings with duplicates renamed to ensure uniqueness.
+    """
+    if not keys:
+        return []
+
+    seen: Dict[str, int] = {}
+    result: List[str] = []
+    existing_keys = set(keys)
+
+    for key in keys:
+        if key not in seen:
+            # First occurrence, leave it as is
+            seen[key] = 1
+            result.append(key)
+        else:
+            # Duplicate found, generate a new unique key
+            seen[key] += 1
+            counter = seen[key]
+            new_key = f"{key}_{counter}"
+
+            # Ensure the generated key doesn't conflict with existing ones
+            while new_key in existing_keys or new_key in result:
+                counter += 1
+                new_key = f"{key}_{counter}"
+
+            result.append(new_key)
+            seen[new_key] = 1  # Add the new key to seen to handle further duplicates
+
+    return result
+
+
