 T = TypeVar("T")
 
 
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Renames duplicate keys by appending a suffix (_2, _3, etc.) to avoid collisions.
+    The first occurrence of a key remains unchanged.
+    
+    Examples:
+    >>> dedupe_keys([])
+    []
+    >>> dedupe_keys(["id", "name"])
+    ['id', 'name']
+    >>> dedupe_keys(["id", "id"])
+    ['id', 'id_2']
+    >>> dedupe_keys(["id", "id", "id"])
+    ['id', 'id_2', 'id_3']
+    >>> dedupe_keys(["id", "id", "id_2"])
+    ['id', 'id_3', 'id_2']
+    >>> dedupe_keys(["id_2", "id", "id"])
+    ['id_2', 'id', 'id_3']
+    >>> dedupe_keys(["id", "id", "id_2", "id_2"])
+    ['id', 'id_3', 'id_2', 'id_2_2']
+    """
+    if not keys:
+        return []
+    
+    # Create a working copy
+    result = list(keys)
+    
+    # Count occurrences of each key
+    counts = {}
+    for key in keys:
+        counts[key] = counts.get(key, 0) + 1
+    
+    # If no duplicates, return early
+    if all(count == 1 for count in counts.values()):
+        return result
+    
+    # Track what names we've used in the output
+    used_names = set()
+    
+    # Process each position
+    for i, key in enumerate(keys):
+        if counts[key] == 1:
+            # Unique key, just add to used names
+            used_names.add(key)
+        else:
+            # This key has duplicates
+            # Count how many times this key has appeared so far in result
+            # This approach ensures we correctly number the duplicates
+            prev_occurrences = sum(1 for k in result[:i] if k == key)
+            
+            if prev_occurrences == 0:
+                # First occurrence, keep as is
+                used_names.add(key)
+            else:
+                # Not the first occurrence, need to rename
+                new_key = f"{key}_{prev_occurrences + 1}"
+                # Handle case where new_key might already exist in original or created names
+                counter = prev_occurrences + 1
+                while new_key in used_names or new_key in keys:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result[i] = new_key
+                used_names.add(new_key)
+                
+    return result
+
+
