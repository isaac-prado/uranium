 T = TypeVar("T")
 
 
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate column names by appending numeric suffixes (_2, _3 etc.)
+    to the duplicates, preserving the order of the original keys.
+
+    :param keys: A list of column names, potentially with duplicates
+    :return: A list of unique column names
+    """
+    if not keys:
+        return []
+
+    # Count occurrences of each key
+    key_counts = {}
+    for key in keys:
+        key_counts[key] = key_counts.get(key, 0) + 1
+
+    # Track how many times we've seen each key so far
+    seen_counts = {}
+    result = []
+
+    for key in keys:
+        seen_counts[key] = seen_counts.get(key, 0) + 1
+        if key_counts[key] > 1 and seen_counts[key] > 1:
+            # Find the next available suffix
+            suffix = 2
+            new_key = f"{key}_{suffix}"
+            while new_key in key_counts or new_key in result:
+                suffix += 1
+                new_key = f"{key}_{suffix}"
+            result.append(new_key)
+        else:
+            result.append(key)
+
+    return result
+
+
 class _CloseableIterator(Iterator[Row]):
