@@ -2500,6 +2500,39 @@ class Table(Queryable):
             self.db.execute(sql)
         return self.db.table(new_name)
 
+    def _detect_destructive_foreign_keys(self, table_name: str) -> List[Tuple[str, str]]:
+        """
+        Detect foreign keys pointing to table_name with destructive ON DELETE actions.
+        
+        Returns a list of tuples (referencing_table, on_delete_action) for each
+        foreign key with a destructive action (CASCADE, SET NULL, SET DEFAULT).
+        """
+        destructive_actions = {"CASCADE", "SET NULL", "SET DEFAULT"}
+        destructive_fks = []
+        
+        # Get all tables in the database
+        tables = [row[0] for row in self.db.execute(
+            "SELECT name FROM sqlite_master WHERE type='table'"
+        ).fetchall()]
+        
+        for table in tables:
+            # Skip the table being transformed itself
+            if table == table_name:
+                continue
+                
+            # Check foreign keys in this table
+            fk_rows = self.db.execute(
+                "PRAGMA foreign_key_list({})".format(quote_identifier(table))
+            ).fetchall()
+            
+            for row in fk_rows:
+                id, seq, referenced_table, from_col, to_col, on_update, on_delete, match = row
+                # Check if this foreign key references our target table and has a destructive action
+                if referenced_table == table_name and on_delete in destructive_actions:
+                    destructive_fks.append((table, on_delete))
+                    
+        return destructive_fks
+
     def transform(
         self,
         *,
@@ -2560,6 +2593,23 @@ class Table(Queryable):
             self.db.execute("PRAGMA foreign_keys").fetchone()[0]
         )
         already_in_transaction = self.db.conn.in_transaction
+        
+        # Check for destructive foreign keys when in transaction with foreign keys enabled
+        if already_in_transaction and pragma_foreign_keys_was_on:
+            destructive_fks = self._detect_destructive_foreign_keys(self.name)
+            if destructive_fks:
+                # Build error message with details about referencing tables and actions
+                fk_details = ", ".join(
+                    "{} -> {}".format(table, action) 
+                    for table, action in destructive_fks
+                )
+                raise TransactionError(
+                    "Cannot transform table '{}' while in a transaction with foreign keys enabled "
+                    "because it is referenced by tables with destructive foreign key actions: {}".format(
+                        self.name, fk_details
+                    )
+                )
+        
         should_disable_foreign_keys = (
             pragma_foreign_keys_was_on and not already_in_transaction
         )
