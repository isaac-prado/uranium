+
 try:
     iterdump = importlib.import_module("sqlite_dump").iterdump
 except ImportError:
@@ -3103,10 +3105,25 @@ class Table(Queryable):
         if "rowid" not in new_cols:
             new_cols.insert(0, "rowid")
             old_cols.insert(0, "rowid")
+        
+        # Modify old_cols to use NULLIF for TEXT columns being converted to numeric types
+        old_cols_modified = []
+        for i, (from_col, to_col) in enumerate(zip(old_cols, new_cols)):
+            # Get the original column type
+            original_type = self.columns_dict.get(from_col)
