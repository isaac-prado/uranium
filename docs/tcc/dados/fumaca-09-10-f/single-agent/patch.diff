+    def _split_dotted_key(self, key):
+        """Split a dotted key into its components, respecting quoted parts."""
+        parts = []
+        current_part = ""
+        in_quotes = None  # None, '"' or "'"
+        
+        i = 0
+        while i < len(key):
+            char = key[i]
+            
+            if in_quotes is None:
+                if char in ('"', "'"):
+                    in_quotes = char
+                    current_part += char
+                elif char == '.':
+                    if current_part:
+                        parts.append(current_part)
+                        current_part = ""
+                    else:
+                        # Handle cases like ".." 
+                        raise ValueError("Invalid dotted key: empty part")
+                else:
+                    current_part += char
+            else:
+                if char == in_quotes:
+                    # Check for escaped quotes
+                    if i + 1 < len(key) and key[i + 1] == in_quotes:
+                        current_part += char + char
+                        i += 1  # Skip next quote
+                    else:
+                        in_quotes = None
+                        current_part += char
+                else:
+                    current_part += char
+            
+            i += 1
+        
+        if in_quotes is not None:
+            raise ValueError("Unterminated quoted key part")
+            
+        if current_part:
+            parts.append(current_part)
+            
+        return parts
