+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate column names by appending numeric suffixes (_N) starting from 2.
+    
+    The first occurrence remains unchanged, and each subsequent duplicate gets a 
+    sequential suffix ensuring uniqueness while preserving order.
+    
+    Examples:
+    [] -> []
+    ["id", "name"] -> ["id", "name"]
+    ["id", "id"] -> ["id", "id_2"]
+    ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+    ["id", "id_2", "id"] -> ["id", "id_2", "id_3"]
+    ["id_2", "id", "id_2"] -> ["id_2", "id", "id_2_2"]
+    ["id", "id_2", "id", "id_2"] -> ["id", "id_2", "id_3", "id_2_2"]
+    
+    :param keys: List of column names that may contain duplicates
+    :return: List of unique column names with appropriate suffixes
+    """
+    if not keys:
+        return []
+    
+    result = []
+    # Keep track of all keys we've seen so far
+    seen_keys = set()
+    
+    for key in keys:
+        if key not in seen_keys:
+            # First time seeing this key, use as-is
+            result.append(key)
+            seen_keys.add(key)
+        else:
+            # This key already exists, need to create a new one
+            # Start with suffix _2 and increment until we find an unused suffix
+            suffix = 2
+            new_key = f"{key}_{suffix}"
+            
+            # Keep incrementing until we find a unique key
+            while new_key in seen_keys:
+                suffix += 1
+                new_key = f"{key}_{suffix}"
+            
+            result.append(new_key)
+            seen_keys.add(new_key)
+            
+    return result
+
