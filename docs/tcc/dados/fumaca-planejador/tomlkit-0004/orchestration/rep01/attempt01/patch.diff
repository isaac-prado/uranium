+    def _parse_dotted_key(self):  # type: () -> Key
+        """
+        Parses a dotted key containing multiple parts separated by dots.
+        Each part can be a bare key or a quoted key.
+        """
+        parts = []
+        self.mark()
+        
+        while True:
+            # Parse each part of the dotted key
+            if self._current in "\"'":
+                # Quoted key part
+                quote_char = self._current
+                self.inc()
+                part_start = self._idx
+                
+                # Find the closing quote
+                while not self.end() and self._current != quote_char:
+                    self.inc()
+                
+                if self.end():
+                    raise self.parse_error(UnexpectedCharError, ("EOF",))
+                
+                part = self._src[part_start:self._idx]
+                self.inc()  # Skip closing quote
+            else:
+                # Bare key part
+                part_start = self._idx
+                while not self.end() and self._current.is_bare_key_char():
+                    self.inc()
+                
+                part = self._src[part_start:self._idx]
+            
+            parts.append(part)
+            
+            # Check if there's a dot to continue
+            if self._current == ".":
+                self.inc()  # Skip the dot
+                # Skip any whitespace after the dot
+                while not self.end() and self._current.is_spaces():
+                    self.inc()
+                    
+                if self.end():
+                    raise self.parse_error(UnexpectedCharError, ("EOF",))
+            else:
+                break
+        
+        # Create a special key representation for dotted keys
+        dotted_key_str = ".".join(parts)
+        return Key(dotted_key_str, sep="")
+
