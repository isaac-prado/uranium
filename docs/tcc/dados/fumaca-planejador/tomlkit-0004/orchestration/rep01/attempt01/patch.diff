+    def _handle_dotted_key(self, container, key, value):
+        """
+        Handle dotted keys by creating nested table structure.
+        """
+        from .api import item as _item
+        from .api import table as _table
+        from .items import Table
+        
+        parts = key.key.split(".")
+        current_container = container
+        
+        # Navigate/create intermediate tables
+        for i, part in enumerate(parts[:-1]):
+            if part in current_container:
+                existing = current_container[part]
+                if isinstance(existing, Table):
+                    current_container = existing
+                else:
+                    # Convert existing value to a super table
+                    # This is complex, so for now we'll raise an error
+                    raise self.parse_error(KeyAlreadyPresent, (part,))
+            else:
+                # Create new table for this part
+                new_table = _table()
+                new_table.name = part
+                current_container.append(part, new_table)
+                current_container = new_table
+        
+        # Set the final value
+        final_part = parts[-1]
+        current_container.append(final_part, value)
