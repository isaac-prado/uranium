         if not self.exists():
             raise ValueError("Cannot transform a table that doesn't exist yet")
+        
+        # Check for destructive foreign key references when in an active transaction
+        pragma_foreign_keys_was_on = bool(
+            self.db.execute("PRAGMA foreign_keys").fetchone()[0]
+        )
+        already_in_transaction = self.db.conn.in_transaction
+        
+        if pragma_foreign_keys_was_on and already_in_transaction:
+            # Get all tables that reference this table with destructive actions
+            destructive_references = []
+            for table in self.db.tables:
+                if table.name != self.name:  # Skip the table being transformed
+                    for fk in table.foreign_keys:
+                        if (fk.other_table == self.name and 
+                            fk.on_delete in ("CASCADE", "SET NULL", "SET DEFAULT")):
+                            destructive_references.append((table.name, fk.on_delete))
+            
+            if destructive_references:
+                ref_details = ", ".join(
+                    f"{table_name} (ON DELETE {action})" 
+                    for table_name, action in destructive_references
+                )
+                raise TransactionError(
+                    f"Cannot transform table '{self.name}' while in a transaction with "
+                    f"PRAGMA foreign_keys enabled, as it is referenced by tables with "
+                    f"destructive foreign key actions: {ref_details}"
+                )
