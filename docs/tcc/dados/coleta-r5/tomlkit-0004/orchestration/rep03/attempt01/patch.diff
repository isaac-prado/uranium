+    def _handle_dotted_key(self, container, key_parts, value, sep=" = "):
+        """
+        Handle dotted key by creating nested table structure.
+        """
+        from .container import Container as ItemsContainer
+        
+        # Create nested structure
+        current_container = container
+        for i, part in enumerate(key_parts[:-1]):
+            # Check if part already exists
+            if part in current_container:
+                existing = current_container[part]
+                if isinstance(existing, Table):
+                    current_container = existing
+                else:
+                    # Cannot create nested structure, key conflict
+                    raise self.parse_error(KeyAlreadyPresent, part)
+            else:
+                # Create new table for this part
+                from .items import Trivia
+                new_table = Table(ItemsContainer(), Trivia(), False, is_super_table=(i < len(key_parts) - 2))
+                new_table.name = part
+                current_container.append(part, new_table)
+                current_container = new_table
+                
+        # Set the final value
+        final_key = key_parts[-1]
+        current_container.append(final_key, value)
+
