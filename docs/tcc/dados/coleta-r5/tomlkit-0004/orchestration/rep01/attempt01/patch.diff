+    def _append_dotted_key(self, container, key, value):
+        """
+        Appends a key-value pair to the container, creating nested tables for dotted keys.
+        """
+        # Handle None keys (whitespace/comments)
+        if key is None:
+            container.append(key, value)
+            return
+            
+        # Handle dotted keys according to TOML 0.5.0 spec
+        if "." in key.key and not (key.key.startswith('"') or key.key.startswith("'")):
+            # This is a dotted key, split it and create nested structure
+            parts = key.key.split(".")
+            current_container = container
+            
+            # Navigate/create intermediate tables
+            for part in parts[:-1]:  # All parts except the last one
+                if part not in current_container:
+                    # Create new table for this part
+                    from .api import table
+                    new_table = table()
+                    new_table.name = part
+                    current_container.append(part, new_table)
+                    current_container = new_table
+                else:
+                    # Get existing table
+                    existing = current_container[part]
+                    if hasattr(existing, 'is_super_table'):
+                        existing.is_super_table = lambda: True
+                    current_container = existing
+            
+            # Set the final value in the deepest table
+            final_key = parts[-1]
+            current_container[final_key] = value
+        else:
+            # Regular key, append normally
+            container.append(key, value)
+
