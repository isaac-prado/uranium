+def progressbar(*args, **kwargs):  # type: ignore
+    """
+    Wrapper around click.progressbar that handles the silent flag properly.
+    """
+    silent = kwargs.pop("silent", False)
+    if silent:
+        # Return a context manager that yields a dummy progress bar
+        @contextlib.contextmanager
+        def dummy_progressbar(*args, **kwargs):  # type: ignore
+            class DummyBar:
+                def update(self, n: int = 1) -> None:
+                    pass
+
+            yield DummyBar()
+
+        return dummy_progressbar(*args, **kwargs)
+    else:
+        return click.progressbar(*args, **kwargs)
+
