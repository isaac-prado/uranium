+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate column names by appending numeric suffixes (_2, _3, etc.).
+
+    The first occurrence of a key remains unchanged. Subsequent duplicates are
+    suffixed with the lowest integer that makes them unique, starting from 2.
+
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+
+    Args:
+        keys: A list of column names, potentially with duplicates.
+
+    Returns:
+        A new list of column names with duplicates resolved.
+    """
+    if not keys:
+        return []
+
+    result: List[str] = []
+    # Keep track of all keys we've used so far (generated only)
+    used_keys: Set[str] = set()
+    # Keep track of all original keys to avoid conflicts
+    original_keys = set(keys)
+
+    for key in keys:
+        if key not in used_keys:
+            # First time seeing this specific key, use it as-is
+            result.append(key)
+            used_keys.add(key)
+        else:
+            # Key already used, find the next available suffix
+            # The base key is the original key itself
+            base_key = key
+            
+            # Try suffixes starting from 2
+            suffix_counter = 2
+            new_key = f"{base_key}_{suffix_counter}"
+            
+            # Ensure the generated key doesn't conflict with any original keys or previously generated keys
+            while new_key in original_keys or new_key in used_keys:
+                suffix_counter += 1
+                new_key = f"{base_key}_{suffix_counter}"
+            
+            # Add the new key to our result and tracking sets
+            result.append(new_key)
+            used_keys.add(new_key)
+
+    return result
 
 
