+def chunks(sequence: Iterable[T], chunk_size: int) -> Iterator[List[T]]:
+    """
+    Yield successive chunks of a sequence, each of size chunk_size.
+
+    Args:
+        sequence: An iterable sequence to be chunked
+        chunk_size: The size of each chunk
+
+    Yields:
+        Lists representing chunks of the sequence
+    """
+    iterator = iter(sequence)
+    while True:
+        chunk = list(itertools.islice(iterator, chunk_size))
+        if not chunk:
+            break
+        yield chunk
+
+
+def hash_record(record: Dict[str, Any], keys: List[str]) -> str:
+    """
+    Generate a deterministic hash for a record based on specified keys.
+
+    Args:
+        record: A dictionary representing a record
+        keys: A list of keys to include in the hash
+
+    Returns:
+        A SHA256 hash of the specified keys and their values
+    """
+    hasher = hashlib.sha256()
+    for key in sorted(keys):
+        if key in record:
+            hasher.update(str(record[key]).encode("utf-8"))
+    return hasher.hexdigest()
+
