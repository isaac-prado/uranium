+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve duplicate column names by adding numeric suffixes (_2, _3, etc.)
+    
+    The first occurrence of a name remains unchanged. Each subsequent occurrence
+    gets a suffix starting from _2, ensuring uniqueness.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+        
+    :param keys: List of column names that may contain duplicates
+    :return: List of unique column names
+    """
+    if not keys:
+        return []
+    
+    # Count occurrences of each key
+    key_counts = {}
+    for key in keys:
+        key_counts[key] = key_counts.get(key, 0) + 1
+    
+    # Track how many times we've used each base key
+    key_usage = {}
+    result = []
+    
+    for key in keys:
+        if key_counts[key] == 1:
+            # Unique key, no change needed
+            result.append(key)
+        else:
+            # Duplicate key, need to add suffix
+            usage_count = key_usage.get(key, 0) + 1
+            key_usage[key] = usage_count
+            
+            if usage_count == 1:
+                # First occurrence stays as-is
+                result.append(key)
+            else:
+                # Subsequent occurrences get suffixed
+                new_key = f"{key}_{usage_count}"
+                # Handle case where the suffixed key already exists
+                counter = usage_count
+                while new_key in key_counts or new_key in result:
+                    counter += 1
+                    new_key = f"{key}_{counter}"
+                result.append(new_key)
+    
+    return result
