+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Given a list of column names, return a new list where any duplicates have been made unique
+    by appending _N where N is the smallest integer that doesn't conflict with existing names.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+    
+    # Create a set of all original keys for quick lookup
+    original_keys = set(keys)
+    result: List[str] = []
+    used_keys: Set[str] = set()
+    
+    for key in keys:
+        if key not in used_keys:
+            # First occurrence, keep as is
+            result.append(key)
+            used_keys.add(key)
+        else:
+            # Duplicate found, need to add suffix
+            suffix = 2
+            new_key = f"{key}_{suffix}"
+            # Find the smallest suffix that doesn't conflict with original keys or generated keys
+            while new_key in original_keys or new_key in used_keys:
+                suffix += 1
+                new_key = f"{key}_{suffix}"
+            result.append(new_key)
+            used_keys.add(new_key)
+            
+    return result
