+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Resolve column name collisions by appending numeric suffixes (_2, _3, etc.)
+    to duplicate keys, ensuring all output keys are unique and do not conflict
+    with existing keys.
+
+    Examples:
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id", "id_2", "id"] -> ["id", "id_2", "id_3"]
+
+    Args:
+        keys: A list of column names, potentially with duplicates.
+
+    Returns:
+        A list of unique column names derived from the input.
+    """
+    if not keys:
+        return []
+
+    result: List[str] = []
+    # Track what we've already added to the result
+    used_result_keys: Set[str] = set()
+    # Also track all original keys to avoid conflicts with them
+    original_keys: Set[str] = set(keys)
+    
+    # Process each key in order
+    for key in keys:
+        if key not in used_result_keys:
+            # First time seeing this key in result, use as-is
+            result.append(key)
+            used_result_keys.add(key)
+        else:
+            # Key already exists in result, need to add suffix
+            counter = 2
+            new_key = f"{key}_{counter}"
+            # Check against both original keys and result keys to avoid any conflict
+            while new_key in original_keys or new_key in used_result_keys:
+                counter += 1
+                new_key = f"{key}_{counter}"
+            result.append(new_key)
+            used_result_keys.add(new_key)
+            # Also add to original_keys to prevent future conflicts
+            original_keys.add(new_key)
+            
+    return result
