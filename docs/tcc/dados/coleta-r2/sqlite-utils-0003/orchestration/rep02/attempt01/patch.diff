+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Renomeia chaves duplicadas adicionando sufixos numéricos (_2, _3 etc.)
+    para garantir unicidade, seguindo a regra de sempre verificar se o 
+    nome gerado já existe antes de incrementar.
+    
+    Exemplos:
+    [] -> []
+    ["id", "name"] -> ["id", "name"]
+    ["id", "id"] -> ["id", "id_2"]
+    ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+    ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+    ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+    ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+    """
+    if not keys:
+        return []
+        
+    result: List[str] = []
+    
+    for i, key in enumerate(keys):
+        if key not in result:
+            # Primeira ocorrência, mantém o nome original
+            result.append(key)
+        else:
+            # Encontra o menor sufixo que não colide com nenhum nome existente
+            counter = 2
+            new_key = f"{key}_{counter}"
+            while new_key in result or new_key in keys:
+                counter += 1
+                new_key = f"{key}_{counter}"
+            result.append(new_key)
+            
+    return result
