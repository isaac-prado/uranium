+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Renomeia chaves duplicadas adicionando sufixos numéricos (_2, _3, etc.)
+    para evitar colisões, mantendo a ordem original.
+    
+    Exemplos:
+        [] -> []
+        ['id', 'name'] -> ['id', 'name']
+        ['id', 'id'] -> ['id', 'id_2']
+        ['id', 'id', 'id'] -> ['id', 'id_2', 'id_3']
+        ['id', 'id', 'id_2'] -> ['id', 'id_3', 'id_2']
+        ['id_2', 'id', 'id'] -> ['id_2', 'id', 'id_3']
+        ['id', 'id', 'id_2', 'id_2'] -> ['id', 'id_3', 'id_2', 'id_2_2']
+    """
+    if not keys:
+        return []
+    
+    # Para rastrear quais nomes finais já foram usados
+    used_final = set()
+    result = []
+    
+    # Contador para cada chave base (para saber qual sufixo usar)
+    base_counters = {}
+    
+    for key in keys:
+        if key not in used_final:
+            # Nome ainda não usado como resultado final
+            result.append(key)
+            used_final.add(key)
+            # Inicializa contador para esta chave base, se não existir
+            if key not in base_counters:
+                base_counters[key] = 1
+            else:
+                # Se a chave base já foi usada mas este é um caso novo (como 'id_2' original)
+                # incrementa o contador base
+                base_counters[key] += 1
+        else:
+            # É uma repetição direta - precisa de sufixo
+            # Usar o contador da chave base para determinar o próximo número
+            base_key = key
+            counter = base_counters.get(base_key, 1) + 1
+            
+            # Encontrar o próximo sufixo disponível
+            new_key = f"{base_key}_{counter}"
+            while new_key in used_final or new_key in keys:
+                counter += 1
+                new_key = f"{base_key}_{counter}"
+            
+            result.append(new_key)
+            used_final.add(new_key)
+            base_counters[base_key] = counter
+    
+    return result
