     return dict(_flatten(row))
+
+
+def dedupe_keys(keys: List[str]) -> List[str]:
+    """
+    Remove duplicate keys by appending numeric suffixes to duplicates.
+    
+    The first occurrence of a key remains unchanged. Each subsequent occurrence 
+    gets a suffix '_N' where N starts from 2 and increases to avoid conflicts.
+    
+    Examples:
+        [] -> []
+        ["id", "name"] -> ["id", "name"]
+        ["id", "id"] -> ["id", "id_2"]
+        ["id", "id", "id"] -> ["id", "id_2", "id_3"]
+        ["id", "id", "id_2"] -> ["id", "id_3", "id_2"]
+        ["id_2", "id", "id"] -> ["id_2", "id", "id_3"]
+        ["id", "id", "id_2", "id_2"] -> ["id", "id_3", "id_2", "id_2_2"]
+        
+    :param keys: List of column names to deduplicate
+    :return: New list with deduplicated column names
+    """
+    if not keys:
+        return []
+    
+    # Create a set of all existing keys for quick lookup
+    existing_keys = set(keys)
+    result = []
+    counts: Dict[str, int] = {}
+    
+    for key in keys:
+        if key not in counts:
+            # First occurrence - keep as is
+            counts[key] = 1
+            result.append(key)
+        else:
+            # Duplicate - need to add suffix
+            counts[key] += 1
+            suffix = counts[key]
+            
+            # Find the first available suffix that doesn't conflict
+            while True:
+                new_key = f"{key}_{suffix}"
+                if new_key not in existing_keys and new_key not in result:
+                    result.append(new_key)
+                    break
+                suffix += 1
+                
+    return result
