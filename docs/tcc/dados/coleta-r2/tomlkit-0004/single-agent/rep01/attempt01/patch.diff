     def append(self, key, item):  # type: (Key, Item) -> None
         from .api import item as _item
+        from .items import Table
+        from .items import Trivia
 
         if not isinstance(key, Key) and key is not None:
             key = Key(key)
 
+        # Handle dotted keys
+        if key is not None and hasattr(key, '_keys') and len(key._keys) > 1:
+            # This is a dotted key, we need to create nested structure
+            keys = key._keys
+            root_key = keys[0]
+            intermediate_keys = keys[1:-1]
+            final_key = keys[-1]
+            
+            # Get or create the root table
+            if root_key.key not in self:
+                from .container import Container as ContainerClass
+                root_table = Table(
+                    ContainerClass(),
+                    Trivia("", "", "", ""),
+                    False,
+                    is_super_table=True,
+                    name=root_key.key,
+                )
+                super(Container, self).__setitem__(root_key.key, root_table.value)
+                self._map[Key(root_key.key)] = len(self._body)
+                self._body.append((Key(root_key.key), root_table))
+            else:
+                # Check if the existing item is compatible
+                existing_key = Key(root_key.key)
+                if existing_key in self._map:
+                    existing_item = self._body[self._map[existing_key]][1]
+                    if not isinstance(existing_item, Table):
+                        raise KeyAlreadyPresent(root_key.key)
+            
+            # Navigate/create intermediate tables
+            current_container = self
+            for inter_key in intermediate_keys:
+                if inter_key.key not in current_container:
+                    from .container import Container as ContainerClass
+                    new_table = Table(
+                        ContainerClass(),
+                        Trivia("", "", "", ""),
+                        False,
+                        is_super_table=True,
+                        name=inter_key.key,
+                    )
+                    current_container[inter_key.key] = new_table
+                
+                # Get the actual Table item from the container's body, not its value
+                table_key = Key(inter_key.key)
+                if table_key in current_container._map:
+                    idx = current_container._map[table_key]
+                    table_item = current_container._body[idx][1]  # This is the actual Table object
+                    current_container = table_item
+                else:
+                    raise KeyAlreadyPresent('.'.join([k.key for k in keys[:keys.index(inter_key)+1]]))
+                    
+                if not hasattr(current_container, 'value') or not hasattr(current_container.value, '__setitem__'):
+                    raise KeyAlreadyPresent('.'.join([k.key for k in keys[:keys.index(inter_key)+1]]))
+            
+            # Add the final item to the deepest container
+            # At this point, current_container should be the 'a' table
+            # We need to add 'b' to the 'a' table's internal container
+
+            
+            if hasattr(current_container, 'value') and hasattr(current_container.value, 'append'):
+                # This is a table, add to its internal container using append
+                # print("DEBUG: Using table.value.append branch")
+                current_container.value.append(final_key, item)
+            else:
+                # For containers, use append directly
+                # print("DEBUG: Checking container append branch")
+                if hasattr(current_container, 'append'):
+                    # print("DEBUG: Using container.append branch")
+                    current_container.append(final_key, item)
+                else:
+                    # Fallback - this shouldn't happen
+                    # print("DEBUG: Using fallback branch")
+                    current_container[final_key.key] = item
+            
+            # Track the full dotted key in our body for serialization purposes
+            # But don't add it to the dict to avoid duplication
+            self._map[key] = len(self._body)
+            self._body.append((key, item))
+            
+            return item
+
         if not isinstance(item, Item):
             item = _item(item)
 
