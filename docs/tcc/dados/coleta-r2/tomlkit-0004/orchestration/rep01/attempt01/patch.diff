+    def _split_dotted_key(self, key_str):
+        """
+        Split a dotted key into its parts, respecting quoted strings.
+        """
+        parts = []
+        current_part = ""
+        in_quotes = False
+        quote_char = None
+        i = 0
+        escaped = False
+        
+        while i < len(key_str):
+            char = key_str[i]
+            
+            if char == "\\" and not escaped and in_quotes:
+                escaped = True
+                current_part += char
+            elif char in ('"', "'") and not escaped:
+                if not in_quotes:
+                    in_quotes = True
+                    quote_char = char
+                elif char == quote_char:
+                    in_quotes = False
+                    quote_char = None
+                current_part += char
+                escaped = False
+            elif char == '.' and not in_quotes:
+                if current_part:
+                    parts.append(current_part)
+                current_part = ""
+                escaped = False
+            else:
+                current_part += char
+                escaped = False
+                
+            i += 1
+        
+        if current_part:
+            parts.append(current_part)
+            
+        return parts
