+def _is_numeric_type(type_):
+    """Check if a type is numeric (int, float, or their string equivalents)."""
+    if type_ in (int, float):
+        return True
+    if isinstance(type_, str):
+        return type_.lower() in ('integer', 'int', 'float', 'real')
+    return False
