+def _check_destructive_references(conn: "sqlite3.Connection", table_name: str) -> List[Tuple[str, str]]:
+    """Check for destructive foreign key references pointing to the given table.
+    
+    Returns a list of tuples (referencing_table, on_delete_action) for each 
+    destructive reference found.
+    """
+    destructive_actions = {'CASCADE', 'SET NULL', 'SET DEFAULT'}
+    destructive_refs = []
+    
+    # Query to get all foreign key constraints in the database
+    fk_query = """
+        SELECT 
+            m.name AS referencing_table,
+            f."table" AS referenced_table,
+            f.on_delete AS on_delete_action
+        FROM 
+            sqlite_master AS m
+        JOIN 
+            pragma_foreign_key_list(m.name) AS f
+        WHERE 
+            f."table" = ?
+    """
+    
+    conn.row_factory = sqlite3.Row  # Enable named access
+    cursor = conn.execute(fk_query, (table_name,))
+    for row in cursor.fetchall():
+        if row['on_delete_action'].upper() in destructive_actions:
+            destructive_refs.append((row['referencing_table'], row['on_delete_action'].upper()))
+            
+    return destructive_refs
