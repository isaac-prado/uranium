+# Predeclared types (https://go.dev/ref/spec#Predeclared_identifiers) plus
+# the type constructors ``map`` and ``chan``.  A name from this list is
+# always a type, also when it is used in a conversion such as ``int64(x)``.
+GO_TYPES = (
+    'uint', 'uint8', 'uint16', 'uint32', 'uint64',
+    'int', 'int8', 'int16', 'int32', 'int64',
+    'float32', 'float64', 'complex64', 'complex128',
+    'byte', 'rune', 'string', 'bool', 'error', 'uintptr',
+    'any', 'comparable', 'map', 'chan',
+)
+
+# Builtin functions (https://go.dev/ref/spec#Built-in_functions).
+GO_BUILTIN_FUNCS = (
+    'print', 'println', 'panic', 'recover', 'close', 'complex',
+    'real', 'imag', 'len', 'cap', 'append', 'copy', 'delete',
+    'new', 'make', 'min', 'max', 'clear',
+)
+
+# Operators (https://go.dev/ref/spec#Operators_and_punctuation); the
+# remaining tokens of that table (brackets, ``...``, ``~`` and the
+# separators) are punctuation.
+GO_OPERATORS = (
+    '+', '-', '*', '/', '%', '&', '|', '^', '<<', '>>', '&^',
+    '+=', '-=', '*=', '/=', '%=', '&=', '|=', '^=', '<<=', '>>=', '&^=',
+    '&&', '||', '<-', '++', '--',
+    '==', '!=', '<', '<=', '>', '>=',
+    '=', ':=', '!',
+)
+
+# Integer literals (https://go.dev/ref/spec#Integer_literals): the token
+# type depends on the prefix, see _int_literal.
+GO_INT_LITERAL = (r'0[bB](?:_?[01])+'
+                  r'|0[xX](?:_?[0-9a-fA-F])+'
+                  r'|0[oO]?(?:_?[0-7])+'
+                  r'|0|[1-9](?:_?[0-9])*')
+
+
+def _int_literal(lexer, match):
+    text = match.group()
+    base = text[1:2].lower() if len(text) > 1 and text[0] == '0' else ''
+    if base == 'b':
+        token = Number.Bin
+    elif base == 'x':
+        token = Number.Hex
+    elif base:
+        token = Number.Oct
+    else:
+        token = Number.Integer
+    yield match.start(), token, text
+
+
