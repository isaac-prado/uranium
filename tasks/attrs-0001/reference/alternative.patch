--- a/src/attr/_make.py
+++ b/src/attr/_make.py
@@ -1901,6 +1901,39 @@ def _add_repr(cls, ns=None, attrs=None):
     return cls
 
 
+def _unsubscripted_class(cls):
+    """
+    Map *cls* to the class it stands for.
+
+    Plain classes are returned unchanged.  Parametrized generics like
+    ``A[str]`` are mapped to their unsubscripted class ``A``.  Anything else
+    yields ``None``.
+    """
+    if isinstance(cls, type):
+        return cls
+
+    origin = typing.get_origin(cls)
+    if isinstance(origin, type):
+        return origin
+
+    return None
+
+
+def _lookup_attrs_attrs(cls):
+    """
+    Return the *attrs* attributes of *cls*, or ``None`` if it has none.
+
+    Parametrized generics are looked up on their unsubscripted class.
+
+    :raise TypeError: If *cls* is neither a class nor a parametrized generic.
+    """
+    target = _unsubscripted_class(cls)
+    if target is None:
+        raise TypeError("Passed object must be a class.")
+
+    return getattr(target, "__attrs_attrs__", None)
+
+
