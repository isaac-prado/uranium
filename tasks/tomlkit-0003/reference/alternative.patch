+def _mirror_entry(table, key):  # type: (dict, Union[Key, str, None]) -> None
+    """
+    Refreshes one entry of the plain dict view of a table from its container.
+
+    The container may merge an appended item into one it already holds
+    (several [a.b.x] headers all extend the same [a.b] table), so the dict
+    view must reflect what the container ended up with, not the object that
+    was passed in.
+    """
+    if isinstance(key, Key):
+        key = key.key
+
+    if key is None or key not in table.value:
+        return
+
+    dict.__setitem__(table, key, table.value.item(key))
+
