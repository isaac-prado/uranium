+class DottedKey(Key):
+    """
+    A key made of several parts separated by dots, like ``a.b."c"``.
+
+    It keeps the original text, so that it can be written back unchanged,
+    and the individual parts, which describe the path of implicit tables
+    leading to the value.
+    """
+
+    def __init__(self, parts, original, sep=None):  # type: (List[Key], str) -> None
+        super(DottedKey, self).__init__(original, KeyType.Bare, sep)
+
+        self.parts = tuple(parts)
+
+    def as_string(self):  # type: () -> str
+        return self.key
+
+    def __hash__(self):  # type: () -> int
+        return hash(tuple(p.key for p in self.parts))
+
+    def __eq__(self, other):  # type: (Key) -> bool
+        if not isinstance(other, DottedKey):
+            return False
+
+        return self.parts == other.parts
+
+    def __repr__(self):  # type: () -> str
+        return "<DottedKey {}>".format(self.as_string())
+
+
 class Item(object):
     """
     An item within a TOML document.
