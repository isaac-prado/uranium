+def dedupe_keys(keys: Iterable[str]) -> List[str]:
+    """
+    Make every name in a list of column names unique, preserving order.
+
+    The first occurrence of a name is kept as-is. Each repeat becomes
+    ``name_N``, where ``N`` counts up from 2 and skips any value that would
+    produce a name already present in ``keys`` or already assigned to an
+    earlier repeat. ``["id", "id", "id_2"]`` becomes ``["id", "id_3", "id_2"]``.
+
+    :param keys: Column names, possibly containing repeats
+    """
+    names = list(keys)
+    # Every name that is already spoken for: all the originals, plus every
+    # renamed repeat as it gets assigned
+    reserved: Set[str] = set(names)
+    if len(reserved) == len(names):
+        return names
+    first_seen: Set[str] = set()
+    next_suffix: Dict[str, int] = {}
+    output: List[str] = []
+    for name in names:
+        if name not in first_seen:
+            first_seen.add(name)
+            output.append(name)
+            continue
+        n = next_suffix.get(name, 2)
+        while "{}_{}".format(name, n) in reserved:
+            n += 1
+        renamed = "{}_{}".format(name, n)
+        reserved.add(renamed)
+        next_suffix[name] = n + 1
+        output.append(renamed)
+    return output
+
+
