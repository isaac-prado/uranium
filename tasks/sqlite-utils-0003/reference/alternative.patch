+def _rows_as_dicts(
+    description: Sequence[Sequence[Any]], rows: Iterable[Sequence[Any]]
+) -> Generator[dict, None, None]:
+    """
+    Turn the rows of a cursor into dictionaries keyed by column name.
+
+    Results can repeat a column name - a join of two tables that both have
+    an ``id``, say - so the names are made unique first; otherwise the later
+    value would silently replace the earlier one in each dictionary.
+    """
+    keys = dedupe_keys(column[0] for column in description)
+    return (dict(zip(keys, row)) for row in rows)
