+class QueryEvent(object):
+    """Describes one SQL statement executed by a database."""
+    __slots__ = ('sql', 'params', 'duration', 'exception')
+
+    def __init__(self, sql, params, duration, exception=None):
+        self.sql = sql
+        self.params = params
+        self.duration = duration
+        self.exception = exception
+
+    def __repr__(self):
+        return '<QueryEvent sql=%r params=%r duration=%.6f exception=%r>' % (
+            self.sql, self.params, self.duration, self.exception)
+
+
+class _NullQueryObserver(object):
+    __slots__ = ()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        return False
+
+_null_query_observer = _NullQueryObserver()
+
+
+class _QueryObserver(object):
+    """Times the block it wraps and reports the outcome to the hooks."""
+    __slots__ = ('hooks', 'sql', 'params', 'started')
+
+    def __init__(self, hooks, sql, params):
+        self.hooks = hooks
+        self.sql = sql
+        self.params = params
+        self.started = None
+
+    def __enter__(self):
+        self.started = time.perf_counter()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        if exc_type is not None and not issubclass(exc_type, Exception):
+            return False  # KeyboardInterrupt, SystemExit, etc.
+        event = QueryEvent(self.sql, self.params,
+                           time.perf_counter() - self.started, exc_value)
+        # Iterate over a snapshot, so a hook may unregister itself.
+        for hook in tuple(self.hooks):
+            hook(event)
+        return False
+
+
+class QueryHooks(list):
+    """
+    List of callables invoked with a :class:`QueryEvent` after each SQL
+    statement executed by the owning database, successful or not.
+    """
+    __slots__ = ()
+
+    def observe(self, sql, params):
+        if not self:
+            return _null_query_observer
+        return _QueryObserver(self, sql, params)
+
