+def key(k: Union[str, Iterable[str]]) -> Key:
+    """
+    Creates a key. A string gives a simple key; a sequence of strings gives a
+    dotted key (``["a", "b"]`` is ``a.b``).
+    """
+    if isinstance(k, str):
+        return SingleKey(k)
+
+    parts = [SingleKey(part) for part in k]
+    if not parts:
+        raise ValueError("A dotted key needs at least one part")
+    if len(parts) == 1:
+        return parts[0]
+
+    return DottedKey(parts, sep=" = ")
 
 
