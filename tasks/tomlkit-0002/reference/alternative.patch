+def _unfold_dotted_key(key: Key, value: "Item") -> "Tuple[Key, Item]":
+    """
+    Turns ``a.b.c = value`` into the equivalent ``a = {b = {c = value}}``,
+    built from the innermost level outwards with super tables, so the caller
+    only ever stores a single key. The parts of ``key`` are copied, never
+    mutated, so the same key object can be reused.
+    """
+    from .container import Container
+
+    parts = []
+    for part in key:
+        part = copy.copy(part)
+        part._keys = [part]
+        parts.append(part)
+
+    child_key = parts[-1]
+    child_key.sep = key.sep
+    child_key._dotted = False
+    child = value
+    for part in reversed(parts[:-1]):
+        part._dotted = True
+        wrapper = Table(Container(True), Trivia(), False, is_super_table=True)
+        wrapper.raw_append(child_key, child)
+        child_key, child = part, wrapper
+
+    return child_key, child
+
+
+def _is_compound_key(key: Any) -> bool:
+    return isinstance(key, DottedKey) and len(key._keys) > 1
+
