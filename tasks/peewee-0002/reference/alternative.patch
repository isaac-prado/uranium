+def requires_open_connection(method):
+    # Transaction-ending methods must never open a connection implicitly: the
+    # transaction they would end lived on a connection that is already gone.
+    action = method.__name__
+
+    @wraps(method)
+    def inner(self, *args, **kwargs):
+        if self.is_closed():
+            raise InterfaceError('Cannot %s, database connection not open.'
+                                 % action)
+        return method(self, *args, **kwargs)
