# OpenRouter (tier 100% GRATUITO — sufixo :free)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_MODEL_NAME=qwen/qwen-2.5-7b-instruct:free

AUTO_JSON_FALLBACK_FOR_FREE=true
STRUCTURED_OUTPUT_METHOD=json_mode
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=180

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=uranium-poc

# Limites de iteração do workflow
MAX_CLARIFICATION_ITERATIONS=3
MAX_VALIDATION_ITERATIONS=2
