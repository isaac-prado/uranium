# ─────────────────────────────────────────────────────────────────────────────
# LLM — OpenRouter com provedor pinado
#
# Os dois braços do estudo usam EXATAMENTE esta configuração.
# Modelo de tier gratuito (:free) é recusado: não permite pinar provedor
# nem garantir que temperature/seed sejam respeitados.
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Definidos pelo teste de aptidão:
#   uv run python scripts/fitness_test.py --list-providers <modelo>
#   uv run python scripts/fitness_test.py --model <modelo> --provider <provedor>
OPENROUTER_MODEL_NAME=
OPENROUTER_PROVIDER=

# Determinismo. require_parameters=true faz o OpenRouter recusar provedor
# que não honre estes parâmetros, em vez de ignorá-los em silêncio.
LLM_TEMPERATURE=0
LLM_SEED=20260820
LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT=90

# Tentativas por chamada diante de erro transitório (429, 5xx, timeout).
# O padrão do LangChain é 2 e não segurou um `engine_overloaded` do pool
# compartilhado do provedor: o run inteiro morreu no meio.
LLM_MAX_RETRIES=6

# Saída estruturada: mesmo mecanismo das ferramentas. Sem reparo de JSON.
STRUCTURED_OUTPUT_METHOD=function_calling
STRUCTURED_OUTPUT_RETRIES=2

# Turnos são o orçamento; tokens são só a rede de segurança.
#
# O contexto inteiro é reenviado a cada turno, então o consumo cresce com o
# QUADRADO do número de turnos: medido em +1,1k a +1,5k tokens de prompt por
# turno na tomlkit-0001, 40 turnos implicam ~960k tokens. Um teto de 400k é
# atingido no turno 25 — o manifesto declararia 40 turnos e entregaria 25.
#
# Pior: run cortado tem o custo censurado à direita (sabe-se que gastou ≥ o
# teto, não quanto gastaria). Como custo é desfecho secundário do estudo,
# censura frequente inutiliza a comparação.
#
# Turno é comparável entre repositórios; token não é, porque depende do
# tamanho dos arquivos. Com teto de token apertado, o peewee ganharia menos
# turnos que o tomlkit e o orçamento variaria em silêncio conforme o repo.
#
# CONGELADOS em 12/10/2026 (decisão 12, G4; docs/tcc/07-e4-fumaca.md seção 13):
# 120 turnos (fumaça D, melhor resultado na grande; 160 piorou), 8 M tokens
# (máx. observado 8,1 M em 160 turnos; nenhum corte por tokens a 120),
# 3.600 s (2× o máximo observado, 1.823 s, que foi latência do provedor).
RUN_MAX_TOKENS=8000000
RUN_MAX_WALL_SECONDS=3600
RUN_MAX_TURNS=120

# ─────────────────────────────────────────────────────────────────────────────
# Workflow (braço orchestration)
# ─────────────────────────────────────────────────────────────────────────────
MAX_CLARIFICATION_ITERATIONS=3
# Reprovações da revisão semântica antes de desistir. Suíte vermelha não tem
# teto: volta ao developer até o orçamento acabar, como no single-agent.
MAX_SEMANTIC_REJECTIONS=2
# 0 = sem teto (rodada 3, decisão 32): parada só por suíte verde ou orçamento.

# Revisão semântica do validator após a suíte verde; desligável para isolar o efeito (folga F9 — vai ao manifesto em orchestration_policy.semantic_review)
SEMANTIC_REVIEW=true

# Memória de trabalho do developer entre os ciclos de validação (decisão 8
# do autor, revista em 09/10/2026; manifesto em orchestration_policy.developer_memory).
#   ledger — o developer recebe o registro do que fez nos ciclos anteriores
#            (arquivos lidos, buscas, escritas, suítes, nota final) e o diff
#            atual do workspace, montados pela orquestração sem chamada extra.
#   none   — conversa reconstruída do zero a cada ciclo (fumaças A a F).
DEVELOPER_MEMORY=ledger

# Teto de turnos por ciclo do developer (decisão 25, 09/10/2026; manifesto em
# orchestration_policy.developer_cycle_max_turns). Ao atingi-lo o developer
# volta ao validador e recebe o veredito com a memória; o run segue até o
# orçamento total (RUN_MAX_TURNS). 0 desliga (fumaças A a G).
DEVELOPER_CYCLE_MAX_TURNS=40

# Primeira mensagem do developer do orchestration (manifesto em
# orchestration_policy.developer_input). intent = só a intent do refinador
# (coleta principal). enunciado+intent = enunciado íntegro + intent como anexo:
# SÓ no braço de ablação do refinador (decisões 7 e 16, 14/10/2026).
DEVELOPER_INPUT=intent

# Versão do refinador de intent (manifesto em orchestration_policy.intent_refiner).
# v1 = o prompt do TFG, que resume (coleta principal de 12-13/10).
# v2 = enriquece: copia literalmente reprodução, saídas esperadas e restrições
#      do ambiente, critérios verificáveis (decisão 28, 14/10/2026).
INTENT_REFINER=v1

# Rodada 2 (decisão 29, 14/10/2026), SÓ no braço orquestrado da rodada 2:
# REVIEW_EXECUTION=on  → o validador executa os blocos de reprodução da
#                        intent v2 e entrega as saídas reais ao revisor.
# CYCLE_NOTE=on        → ao bater o teto do ciclo o developer escreve uma nota
#                        (o que fez, por quê, o que falta) que entra na memória.
# off nos dois = coleta principal de 12-13/10.
REVIEW_EXECUTION=off
CYCLE_NOTE=off
# Rodada 3 (decisão 32, 14/10/2026): REVIEW_STRICT=on → revisão que lista
# critérios não cobertos não aprova; com MAX_SEMANTIC_REJECTIONS=0.
REVIEW_STRICT=off
# Rodada 4 (decisão 33, 15/10/2026): PLANNER=on liga o planejador, que explora o
# repositório só com leitura (PLANNER_MAX_TURNS turnos, no orçamento) e fatia a
# intent em até PLANNER_MAX_SUBTASKS sub-tarefas; o developer ataca uma por
# ciclo, o validador confere cada uma com os blocos de reprodução dela e a
# adia depois de SUBTASK_MAX_CYCLES ciclos; plano esgotado com a tarefa aberta
# replaneja até PLANNER_MAX_REPLANS vezes. REVIEW_EXECUTION=cumulative
# (decisão 34) roda cada bloco de reprodução precedido dos anteriores.
PLANNER=off
PLANNER_MAX_TURNS=12
PLANNER_MAX_SUBTASKS=6
PLANNER_MAX_REPLANS=1
SUBTASK_MAX_CYCLES=2
# Rodada 5 (decisões 35 a 38, 15/10/2026): SUBTASK_CHECK=deterministic dá o
# veredito da sub-tarefa comparando a saída real dos blocos dela com as saídas
# esperadas que o planejador apontou (src/verificacao.py), sem o modelo;
# REVIEW_COMPARE=advisory entrega a mesma comparação ao revisor final (strict
# reprova sozinho; guardado); PLANNER_CONTEXT_MAX_CHARS=16000 entrega ao
# developer os trechos que o planejador leu dos arquivos da sub-tarefa. A
# rodada 5 roda com PLANNER_MAX_TURNS=8 e PLANNER_MAX_SUBTASKS=3. llm/off/0 e
# 12/6 reproduzem a rodada 4.
SUBTASK_CHECK=llm
REVIEW_COMPARE=off
PLANNER_CONTEXT_MAX_CHARS=0

# ─────────────────────────────────────────────────────────────────────────────
# Benchmark
# ─────────────────────────────────────────────────────────────────────────────
# URANIUM_MIRROR_DIR=.uranium/mirrors
# URANIUM_WORKSPACE_DIR=.uranium/workspaces
# Rodada 6 (decisões 40 a 42, 16/10/2026): SUBTASK_CHECK=hybrid decide a
# sub-tarefa pela comparação quando há saída verificável e, senão, pela revisão
# de sub-tarefa do modelo (a palavra do developer nunca fecha sub-tarefa);
# REVIEW_COMPARE=neutral entrega as linhas de comparação ao revisor final sem a
# regra "não verificável não reprova" (advisory = rodada 5); REVIEW_STRICT=on
# volta; REPRODUCTION_COMPILE_CHECK=on tira da execução e da cadeia acumulada
# os blocos de reprodução que não compilam como Python (rotulados "não é
# evidência"). off reproduz as rodadas 4 e 5.
REPRODUCTION_COMPILE_CHECK=off
# Rodada 7 (decisão 44, 22/10/2026): rodada 4 mais SUBTASK_MAX_CYCLES=1 (sub-tarefa
# travada é adiada após um ciclo de 40 turnos: nas rodadas 4 a 6, 66 das 69
# sub-tarefas concluídas fecharam no 1º ciclo e nenhuma adiada foi concluída
# depois), REPRODUCTION_COMPILE_CHECK=on e REPRODUCTION_SHELL=on (blocos de
# reprodução em linha de comando, `python -m ...` ou script de console do venv da
# tarefa, rodam no validador; off reproduz as rodadas anteriores).
REPRODUCTION_SHELL=off
# Rodada 8 (decisão 48, 22/10/2026): REPRODUCTION_SOURCE=statement conserta a cópia
# dos blocos de reprodução pelo enunciado (cerca perdida; bloco que não compila
# trocado pelo bloco Python mais parecido do enunciado) e BLOCK_EXPECTED=statement
# amarra cada bloco à "saída esperada" escrita logo depois dele no enunciado e
# mostra ao revisor, por linha, encontrada / NÃO encontrada (informação, não regra).
# intent/off reproduzem a rodada 7.
REPRODUCTION_SOURCE=intent
BLOCK_EXPECTED=off
